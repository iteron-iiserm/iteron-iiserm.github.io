---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import { Image } from "astro:assets";
import turingImg from "../assets/Turing.png";
import iiserLogo from "../assets/iiser-mohali-logo.png";
import turingBadgeLogo from "../assets/turinglogo-wo-bg.png";

const team = [
  { name: 'Zayed Darmi', role: 'CORE TEAM', img: '/images/member1.jpg', email: 'ms24123@iisermohali.ac.in' },
  { name: 'Sampreeti Kar', role: 'CORE TEAM', img: '/images/member2.jpg', email: 'ms24116@iisermohali.ac.in' },
  { name: 'Pinchika S.', role: 'CORE TEAM', img: '/images/member3.jpg', email: 'ms24036@iisermohali.ac.in' },
  { name: 'Harsh V. Shreshth', role: 'CORE TEAM', img: '/images/member4.jpg', email: 'ms24085@iisermohali.ac.in' },
  { name: 'Tamaghna Dey', role: 'CORE TEAM', img: '/images/member5.jpg', email: 'ms24205@iisermohali.ac.in' },
  { name: 'Kshitij Salunke', role: 'CORE TEAM', img: '/images/member6.jpg', email: 'ms24024@iisermohali.ac.in' }
];
---

<Layout
  title="Iteron | Team"
  description="Meet the organizing team behind Iteron at Turing Club, IISER Mohali."
>
  <Navbar />
  
  <main class="page-container">
    <div class="side-decor">
      <Image
        src={turingImg}
        alt="TuringClub"
        class="turing-image"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="header-box brutalist-block">
      <h1 class="glitch" data-text="TEAM_MEMBERS">TEAM_MEMBERS</h1>
      <p class="subtitle">> THE ORGANIZING COMMITTEE</p>
    </div>

    <div class="team-grid">
      {team.map((member) => (
        <a
          class="team-card brutalist-block"
          href={`mailto:${member.email}`}
          aria-label={`Email ${member.name}`}
          title={`Email: ${member.email}`}
        >
          <div class="corner-cross">+</div>
          <div class="avatar-box">
            <img src={member.img} alt={member.name} loading="lazy" decoding="async" />
          </div>
          <div class="member-info">
            <h3 class="name">{member.name}</h3>
            <p class="role">[ {member.role} ]</p>
          </div>
        </a>
      ))}
    </div>

    <section class="about-cards" aria-label="About Turing Club and IISER Mohali">
      <article class="about-card brutalist-block">
        <span class="badge-wrap" aria-hidden="true">
          <Image src={turingBadgeLogo} alt="" class="badge-image" loading="lazy" decoding="async" />
        </span>
        <h2 class="about-title">Turing Club</h2>
        <p class="about-text">
          Turing Club is the Computation Club of IISER Mohali. It is a student-led club and community
          where various (abstract) technological applications throughout the sciences are practiced. Turing Club's 
          initiatives are focused to improve the computational literacy of the student community at IISER Mohali, 
          and develop applications to serve the community.
        </p>
        <a
          class="about-link"
          href="https://github.com/IISERM/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Visit GitHub ->
        </a>
      </article>

      <article class="about-card brutalist-block">
        <span class="badge-wrap" aria-hidden="true">
          <Image src={iiserLogo} alt="" class="badge-image" loading="lazy" decoding="async" />
        </span>
        <h2 class="about-title">IISER Mohali</h2>
        <p class="about-text">
          Indian Institute of Science Education and Research Mohali envisions a new generation 
          of scientists dedicated to the pursuit of knowledge in  frontier areas of basic sciences. 
          In an intellectually vibrant academic environment, IISER Mohali nurtures the basic tenets 
          of science education and research at undergraduate and postgraduate levels. In so doing, 
          the institute aims to emerge as a global centre of learning, academic excellence, and innovative research.
        </p>
        <a
          class="about-link"
          href="https://www.iisermohali.ac.in/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Visit IISER Mohali ->
        </a>
      </article>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-container {
    position: relative;
    padding: 120px 5% 5rem;
    max-width: 1200px;
    margin: 0 auto;
    min-height: 100vh;
  }

  .header-box {
    position: relative;
    z-index: 2;
    margin-bottom: 4rem;
    padding: 2rem;
    background: #000;
    text-align: center;
    border-color: var(--accent-purple);
  }

  h1 {
    font-size: 3.5rem;
    color: var(--text-white);
    margin-bottom: 1rem;
    font-family: var(--font-display);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .subtitle {
    color: var(--accent-purple);
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .team-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 3rem;
  }

  .about-cards {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-top: 6rem;
    padding-top: 2.25rem;
    border-top: 2px dashed rgba(176, 58, 255, 0.45);
  }

  .about-card {
    position: relative;
    background: #000;
    padding: 1.5rem 1.5rem 1.4rem;
    border-color: var(--accent-purple);
    overflow: visible;
  }

  .badge-wrap {
    position: absolute;
    top: -26px;
    right: -18px;
    width: 94px;
    height: 94px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transform: rotate(8deg);
    pointer-events: none;
    z-index: 3;
  }

  .badge-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .about-title {
    color: var(--text-white);
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-family: var(--font-mono);
    max-width: calc(100% - 88px);
  }

  .about-text {
    margin: 0;
    color: #d7d7d7;
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: 95%;
  }

  .about-link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--accent-purple);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    letter-spacing: 0.8px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .about-link:hover {
    color: #000;
    background: var(--accent-purple);
    border-bottom-color: var(--accent-purple);
  }

  .about-link:focus-visible {
    color: #000;
    background: var(--accent-purple);
    outline: 2px solid var(--accent-purple);
    outline-offset: 3px;
  }

  .team-card {
    padding: 2rem;
    background: #000;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: all 0.2s;
    text-decoration: none;
    cursor: pointer;
  }

  .team-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: 6px 6px 0 var(--text-white);
    background: var(--accent-purple);
  }

  .team-card:hover .name,
  .team-card:hover .role {
    color: #000;
  }

  .team-card:focus-visible {
    outline: 2px solid var(--accent-purple);
    outline-offset: 4px;
  }

  .team-card:hover .corner-cross {
    color: #000;
  }

  .corner-cross {
    position: absolute;
    top: 10px;
    right: 15px;
    color: var(--accent-purple);
    font-family: var(--font-mono);
    font-weight: bold;
  }

  .avatar-box {
    width: 120px;
    height: 120px;
    background: #111;
    border: 2px solid var(--text-white);
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .avatar-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.2);
  }

  .team-card:hover .avatar-box img {
    filter: grayscale(0%);
  }

  .fallback {
    font-size: 3rem;
    color: var(--border-color);
  }

  .member-info {
    text-align: center;
  }

  .name {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    color: var(--text-white);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .role {
    color: var(--accent-purple);
    font-size: 0.9rem;
    font-weight: bold;
    letter-spacing: 2px;
  }

  @media (max-width: 768px) {
    .page-container {
      padding: 115px 1.25rem 4rem;
    }

    .about-cards {
      gap: 1.75rem;
      margin-top: 4rem;
      padding-top: 1.5rem;
    }

    .about-card {
      padding: 1.2rem 1.1rem 1.15rem;
    }

    .about-title {
      font-size: 1.05rem;
      max-width: calc(100% - 72px);
    }

    .about-text {
      font-size: 0.92rem;
      line-height: 1.55;
      max-width: 100%;
    }

    .team-grid {
      gap: 1.75rem;
    }

    h1 {
      font-size: 2.5rem;
    }

    .side-decor {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .header-box {
      padding: 1.25rem;
      margin-bottom: 2rem;
    }

    h1 {
      font-size: 1.7rem;
      letter-spacing: 2px;
    }

    .subtitle {
      font-size: 0.9rem;
      letter-spacing: 1px;
    }

    .badge-wrap {
      width: 72px;
      height: 72px;
      top: -18px;
      right: -10px;
    }

    .about-cards {
      margin-top: 3.25rem;
      gap: 1.4rem;
      padding-top: 1.2rem;
    }

    .about-title {
      font-size: 0.98rem;
      margin-bottom: 0.6rem;
      max-width: calc(100% - 64px);
    }

    .about-text {
      font-size: 0.88rem;
      line-height: 1.5;
    }

    .team-card {
      padding: 1.55rem 1.25rem;
    }

    .avatar-box {
      width: 100px;
      height: 100px;
      margin-bottom: 1rem;
    }

    .name {
      font-size: 1.1rem;
      line-height: 1.45;
      margin-bottom: 0.65rem;
    }

  }

  /* Decorative Side Image */
  .side-decor {
    position: absolute;
    right: -8rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 0;
    opacity: 0.35;
    pointer-events: none;
  }

  .turing-image {
    height: 28vh;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(4px 4px 0 var(--accent-purple));
  }

  @media (max-width: 1200px) {
    .side-decor {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll('.avatar-box img').forEach((img) => {
    img.addEventListener('error', () => {
      const parent = img.parentElement;
      if (!parent) return;

      parent.replaceChildren();
      const fallback = document.createElement('div');
      fallback.className = 'fallback';
      fallback.textContent = '👤';
      parent.appendChild(fallback);
    }, { once: true });
  });
</script>
