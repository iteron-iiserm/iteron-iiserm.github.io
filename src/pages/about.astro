---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import { Image } from "astro:assets";
import turingImg from "../assets/Turing.png";

const team = [
  { name: 'Zayed Darmi', role: 'CORE TEAM', img: '/images/member1.jpg' },
  { name: 'Sampreeti Kar', role: 'CORE TEAM', img: '/images/member2.jpg' },
  { name: 'Pinchika S.', role: 'CORE TEAM', img: '/images/member3.jpg' },
  { name: 'Harsh V. Shreshth', role: 'CORE TEAM', img: '/images/member4.jpg' },
  { name: 'Tamaghna Dey', role: 'CORE TEAM', img: '/images/member5.jpg' },
  { name: 'Kshitij Salunke', role: 'CORE TEAM', img: '/images/member6.jpg' }
];
---

<Layout
  title="Iteron | Team"
  description="Meet the organizing team behind Iteron at Turing Club, IISER Mohali."
>
  <Navbar />
  
  <main class="page-container">
    <div class="side-decor">
      <Image
        src={turingImg}
        alt="TuringClub"
        class="turing-image"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="header-box brutalist-block">
      <h1 class="glitch" data-text="TEAM_MEMBERS">TEAM_MEMBERS</h1>
      <p class="subtitle">> THE ORGANIZING COMMITTEE</p>
    </div>

    <div class="team-grid">
      {team.map((member) => (
        <div class="team-card brutalist-block">
          <div class="corner-cross">+</div>
          <div class="avatar-box">
            <img src={member.img} alt={member.name} loading="lazy" decoding="async" />
          </div>
          <div class="member-info">
            <h3 class="name">{member.name}</h3>
            <p class="role">[ {member.role} ]</p>
          </div>
        </div>
      ))}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .page-container {
    position: relative;
    padding: 120px 5% 5rem;
    max-width: 1200px;
    margin: 0 auto;
    min-height: 100vh;
  }

  .header-box {
    position: relative;
    z-index: 2;
    margin-bottom: 4rem;
    padding: 2rem;
    background: #000;
    text-align: center;
    border-color: var(--accent-purple);
  }

  h1 {
    font-size: 3.5rem;
    color: var(--text-white);
    margin-bottom: 1rem;
    font-family: var(--font-display);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .subtitle {
    color: var(--accent-purple);
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .team-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 3rem;
  }

  .team-card {
    padding: 2rem;
    background: #000;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: all 0.2s;
  }

  .team-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: 6px 6px 0 var(--text-white);
    background: var(--accent-purple);
  }

  .team-card:hover .name,
  .team-card:hover .role {
    color: #000;
  }

  .team-card:hover .corner-cross {
    color: #000;
  }

  .corner-cross {
    position: absolute;
    top: 10px;
    right: 15px;
    color: var(--accent-purple);
    font-family: var(--font-mono);
    font-weight: bold;
  }

  .avatar-box {
    width: 120px;
    height: 120px;
    background: #111;
    border: 2px solid var(--text-white);
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .avatar-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.2);
  }

  .team-card:hover .avatar-box img {
    filter: grayscale(0%);
  }

  .fallback {
    font-size: 3rem;
    color: var(--border-color);
  }

  .member-info {
    text-align: center;
  }

  .name {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    color: var(--text-white);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .role {
    color: var(--accent-purple);
    font-size: 0.9rem;
    font-weight: bold;
    letter-spacing: 2px;
  }

  @media (max-width: 768px) {
    .page-container {
      padding: 115px 1.25rem 4rem;
    }

    .team-grid {
      gap: 1.75rem;
    }

    h1 {
      font-size: 2.5rem;
    }

    .side-decor {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .header-box {
      padding: 1.25rem;
      margin-bottom: 2rem;
    }

    h1 {
      font-size: 1.7rem;
      letter-spacing: 2px;
    }

    .subtitle {
      font-size: 0.9rem;
      letter-spacing: 1px;
    }

    .team-card {
      padding: 1.55rem 1.25rem;
    }

    .avatar-box {
      width: 100px;
      height: 100px;
      margin-bottom: 1rem;
    }

    .name {
      font-size: 1.1rem;
      line-height: 1.45;
      margin-bottom: 0.65rem;
    }
  }

  /* Decorative Side Image */
  .side-decor {
    position: absolute;
    right: -8rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 0;
    opacity: 0.35;
    pointer-events: none;
  }

  .turing-image {
    height: 28vh;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(4px 4px 0 var(--accent-purple));
  }

  @media (max-width: 1200px) {
    .side-decor {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll('.avatar-box img').forEach((img) => {
    img.addEventListener('error', () => {
      const parent = img.parentElement;
      if (!parent) return;

      parent.replaceChildren();
      const fallback = document.createElement('div');
      fallback.className = 'fallback';
      fallback.textContent = '👤';
      parent.appendChild(fallback);
    }, { once: true });
  });
</script>
