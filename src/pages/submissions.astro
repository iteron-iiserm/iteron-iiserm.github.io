---
import Navbar from "../components/common/Navbar.astro"
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Submissions</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&display=swap" rel="stylesheet">
    <style>
      body {
        margin: 0;
        height: 100vh;
        background-color: black;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        font-family: 'Playfair Display', serif;
      }
      .page-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 80px;
      }
      .stack-section {
        display: flex;
        flex-direction: column;
        gap: 30px;
        max-width: 600px;
        margin: 100px auto;
        color: white;
        font-family: Cinzel;
        font-style: italic;
      }
      .box {
        padding: 40px;
        background: #1f0631;
        color: white;
        border-radius: 12px;
        opacity: 0;
        transform: translateY(30px);
        animation: fadeUp 0.8s ease forwards;
      }
      /* Stagger effect */
      .box:nth-child(1) { animation-delay: 0.2s; }
      .box:nth-child(2) { animation-delay: 0.5s; }
      .box:nth-child(3) { animation-delay: 0.8s; }
      .box:nth-child(4) { animation-delay: 1.1s; }
      @keyframes fadeUp {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .hero-header {
        width: 100%;
        display: flex;
        justify-content: center;
        margin-top: 60px;
      }
      .header-box {
        width: 70%;
        max-width: 800px;
        padding: 80px 40px;
        background-image: url("/images/Sban.png");
        background-size: cover;
        background-position: center;
        border-radius: 10px;
        box-shadow: 0 10px 10px rgba(241, 44, 234, 0.6);
        text-align: center;
        position: relative;
        opacity: 0;
        transform: translateY(30px);
        animation: fadeInUp 1.2s ease forwards;
      }
      .header-box::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
          rgba(0, 0, 0, 0.3),
          rgba(0, 0, 0, 0.2)
        );
        border-radius: 10px;
      }
      .header-box h1 {
        position: relative;
        z-index: 2;
        font-style: italic;
        font-size: 3.2rem;
        letter-spacing: 4px;
        color: white;
      }
      @keyframes fadeInUp {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Submission Guidelines heading */
      .guidelines-heading {
       color: #ff69b4;
       font-family: Cinzel, serif;
       font-size: 1.6rem;
       letter-spacing: 3px;
      margin: 40px 40px 10px 40px;   /* fixed: all four values need units */
     font-style: italic;
     opacity: 0;
     transform: translateY(20px);
    animation: fadeUp 0.8s ease forwards;
    animation-delay: 0.8s;
} 
      

      /* PDF download link */
      .pdf-download-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #ff69b4;
        font-family: Cinzel, serif;
        font-size: 0.95rem;
        letter-spacing: 2px;
        text-decoration: none;
        border: 1px solid #ff69b4;
        padding: 10px 20px;
        border-radius: 6px;
        transition: background 0.3s ease, color 0.3s ease;
        opacity: 0;
        animation: fadeUp 0.8s ease forwards;
        animation-delay: 1s;
      }
      .pdf-download-link:hover {
        background: #ff69b4;
        color: black;
      }
      .pdf-download-link::before {
        content: "↓";
        font-size: 1rem;
      }

     .guidelines-block {
  max-width: 600px;
  margin: 30px auto 60px auto;   
  display: flex;
  flex-direction: column;
  align-items: center;           
  gap: 16px;
  text-align: center;            
}
    </style>
  </head>
  <body>
    <Navbar/>
    <header class="hero-header">
      <div class="header-box">
        <h1>STRATEGY SUBMISSIONS</h1>
      </div>
    </header>

  
    <div class="guidelines-block">

    General Information
Event Description: A round-robin computational tournament designed to evaluate strategies across a variety of strategic environments using
cumulative payoffs.
Medium: Online
Eligibility: Open to all students (School, Undergraduate, Postgraduate,
and PhD, associated with some university)

      <a href="/Rule_Book_ITERON__Copy_.pdf" download="Rule_Book_ITERON__Copy_.pdf" class="pdf-download-link">
       Rule_Book_ITERON( Click to download)
      </a>
      <a href="https://tally.so/r/b5OKN6" target="_blank" rel="noopener noreferrer" class="pdf-download-link">
    Submission Form
  </a>
    </div>

  </body>
</html>
