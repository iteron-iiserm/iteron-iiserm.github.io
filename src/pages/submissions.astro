---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/common/Navbar.astro";
import Footer from "../components/common/Footer.astro";
import { Image } from "astro:assets";
import chessBoardImg from "../assets/chess-board.png";
import { payoffMatrices } from "../data/payoffMatrices";
---

<Layout
  title="Iteron | Submit Strategy"
  description="Submit your Iteron strategy and access the official template and submission portal."
>
  <Navbar />

  <main class="page-container">
    <header class="header-box brutalist-block">
      <h1 class="glitch" data-text="SUBMISSIONS">SUBMISSIONS</h1>
      <p class="subtitle">> SUBMISSION PORTAL & DOCUMENTATION</p>
    </header>

    <div class="actions-grid">
      <a
        href="https://tally.so/r/b5OKN6"
        target="_blank"
        rel="noopener noreferrer"
        class="action-card brutalist-block highlight-card"
      >
        <span class="corner-tag">[ 01 ]</span>
        <h3>SUBMISSION FORM</h3>
        <span class="arrow">-></span>
      </a>

      <a
        href="https://colab.research.google.com/drive/1WoadT0bsvaYXMZ5XHBvmEQie7rZf9v8f?usp=sharing"
        target="_blank"
        rel="noopener noreferrer"
        class="action-card brutalist-block"
      >
        <span class="corner-tag">[ 02 ]</span>
        <h3>STRATEGY TEMPLATE</h3>
        <span class="arrow">-></span>
      </a>

      <a
        href="#payoff-matrices"
        class="action-card brutalist-block"
      >
        <span class="corner-tag">[ 03 ]</span>
        <h3>PAYOFF MATRICES</h3>
        <span class="arrow">-></span>
      </a>
    </div>

    <section id="payoff-matrices" class="payoff-section">
      <div class="section-label">PAYOFF MATRICES</div>
      <p class="payoff-intro">
        Official tournament environments from the Iteron rulebook. Each cell is
        represented as <strong>(Player 1, Player 2)</strong>.
      </p>

      <div class="payoff-grid">
        {payoffMatrices.map((matrix) => (
          <article class="payoff-card brutalist-block" aria-labelledby={matrix.id}>
            <h2 id={matrix.id}>{matrix.title}</h2>
            <table class="payoff-table">
              <thead>
                <tr>
                  <th scope="col">Player 1 / Player 2</th>
                  <th scope="col">Cooperate</th>
                  <th scope="col">Defect</th>
                </tr>
              </thead>
              <tbody>
                {matrix.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.action}</th>
                    <td>{row.values[0]}</td>
                    <td>{row.values[1]}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </article>
        ))}
      </div>
    </section>

    <div class="rulebook-divider"></div>

    <section class="rulebook">
      <div class="rulebook-decor">
        <Image
          src={chessBoardImg}
          alt="Chess Board Decor"
          class="chess-board-img"
        />
      </div>
      <div class="section-label">OFFICIAL RULEBOOK</div>

      <div class="rules-grid">
        <div class="rule-card brutalist-block offset-full">
          <div class="rule-tag">OVERVIEW</div>
          <h2>General Information</h2>
          <p>
            A round-robin computational tournament designed to evaluate
            strategies across a variety of strategic environments using
            cumulative payoffs. Inspired by Robert Axelrod's Iterated Prisoner's
            Dilemma Tournament, this event tests the robustness of strategies
            across varying environments rather than a single static payoff
            matrix.
          </p>
          <ul class="rule-list">
            <li>
              <strong>Format:</strong> Round-robin computational tournament, conducted
              online.
            </li>
            <li>
              <strong>Eligibility:</strong> Open to all students and faculty affiliated with any recognized university.
            </li>
            <li>
              <strong>Deadline:</strong> Submission deadline is May 11th 2026 11:59
              PM IST.
            </li>
          </ul>
        </div>

        <div class="rule-card brutalist-block">
          <div class="rule-tag">SECTION_01</div>
          <h2>Introduction</h2>
          <p>
            Welcome to the Iteron. Participants are required to submit
            code-based strategies to compete against one another. Unlike the
            conventional tournament, this event tests the robustness of
            strategies across varying environments.
          </p>
        </div>

        <div class="rule-card brutalist-block">
          <div class="rule-tag">SECTION_02</div>
          <h2>Strategy Originality & Structure</h2>
          <ul class="rule-list">
            <li>
              All submitted strategies must be original and unique. Plagiarism
              of existing open-source strategies without significant
              modification or attribution is strictly prohibited.
            </li>
            <li>
              References will be provided by the organizers. Participants must
              ensure their strategies are distinct from these reference
              implementations.
            </li>
          </ul>
        </div>

        <div class="rule-card brutalist-block">
          <div class="rule-tag">SECTION_03</div>
          <h2>Formatting & Templates</h2>
          <ul class="rule-list">
            <li>
              Strategies must be submitted using the <strong
                >official template</strong
              > provided by the organizers.
            </li>
            <li>
              Submissions in any other format or structure will be rejected.
              Participants may be asked to resubmit in the correct format or
              face immediate disqualification.
            </li>
          </ul>
        </div>

        <div class="rule-card brutalist-block">
          <div class="rule-tag">SECTION_04</div>
          <h2>Testing</h2>
          <ul class="rule-list">
            <li>
              To prevent runtime errors during the actual tournament, the
              organizers have released a Sample Strategy.
            </li>
            <li>
              You are required to test your code against this sample strategy
              before submission.
            </li>
            <li>
              Any additional information regarding the same will be communicated
              via mail.
            </li>
          </ul>
        </div>

        <div class="rule-card brutalist-block">
          <div class="rule-tag">SECTION_05</div>
          <h2>Technical Constraints</h2>
          <ul class="rule-list">
            <li>
              <strong>Machine Learning:</strong> The use of ML within strategies is
              expected to be limited. Strategies relying heavily on computationally
              expensive models may be subject to review regarding time-complexity
              limits.
            </li>
          </ul>
        </div>

        <div class="rule-card brutalist-block">
          <div class="rule-tag">SECTION_06</div>
          <h2>Tournament Structure</h2>
          <ul class="rule-list">
            <li>The tournament will be conducted in a Round Robin format.</li>
            <li>
              Every submitted strategy will play against every other opponent's
              strategy.
            </li>
            <li>
              Every submitted strategy will also play against a copy of itself.
            </li>
          </ul>
        </div>

        <div class="rule-card brutalist-block offset-full">
          <div class="rule-tag">SECTION_07</div>
          <h2>Match Duration & Iteration</h2>
          <ul class="rule-list">
            <li>
              To preserve the game-theoretic essence of the "Shadow of the
              Future," the exact number of rounds per match will not be revealed
              to participants.
            </li>
            <li>
              Strategies should be designed to handle an indefinite time
              horizon.
            </li>
            <li>
              The entire tournament will be iterated more than once to ensure
              statistical significance, remove noise, and guarantee fair
              observations of strategy performance.
            </li>
          </ul>
        </div>

        <div class="rule-card brutalist-block offset-full">
          <div class="rule-tag">SECTION_08</div>
          <h2>The Multi-Environment System</h2>
          <ul class="rule-list">
            <li>
              Unlike the conventional Axelrod's tournament which uses a static
              payoff matrix, this tournament will be conducted across multiple
              environments.
            </li>
            <li>
              The organizers will systematically vary the payoff matrices — the
              rewards for Cooperation and Defection — between tournament runs.
            </li>
            <li>
              Strategies must be robust enough to adapt to changes in
              incentives, rather than being over-fitted to a single payoff
              structure.
            </li>
            <li>The description of payoffs is mentioned below.</li>
          </ul>
        </div>

        <div class="rule-card brutalist-block offset-full">
          <div class="rule-tag">SECTION_09</div>
          <h2>Winner Determination & Aggregate Performance</h2>
          <ul class="rule-list">
            <li>
              The final winner will be determined based on the highest average
              score.
            </li>
            <li>
              This score is calculated by aggregating the points obtained across
              all different payoff matrices and environments.
            </li>
            <li>
              Consistency is key. Even if a strategy places 1st in k out of n
              specific matrix environments, it will receive no special
              consideration if its overall average drops due to poor performance
              in other environments.
            </li>
            <li>
              Final ranking is based solely on overall aggregated performance.
              No separate claims or titles will be awarded for individual
              sub-tournament wins.
            </li>
            <li>
              The ITERON team reserves the right to modify these rules to ensure
              the smooth operation of the tournament. Updates will be
              communicated via official channels.
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-container {
    padding: 120px 5% 5rem;
    max-width: 1200px;
    margin: 0 auto;
    min-height: 100vh;
  }

  .header-box {
    margin-bottom: 4rem;
    padding: 3rem 2rem;
    background: #000;
    text-align: center;
    border-color: var(--accent-purple);
  }

  h1 {
    font-size: 3.5rem;
    color: var(--text-white);
    margin-bottom: 1rem;
    font-family: var(--font-display);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .subtitle {
    color: var(--accent-purple);
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .actions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
    margin-bottom: 6rem;
  }

  .action-card {
    padding: 2.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #000;
    text-decoration: none;
    position: relative;
    transition: all 0.2s;
  }

  .action-card h3 {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    color: var(--text-white);
    margin: 0;
  }

  .arrow {
    font-family: var(--font-mono);
    color: var(--accent-purple);
    font-size: 1.5rem;
    font-weight: bold;
  }

  .corner-tag {
    position: absolute;
    top: -12px;
    left: -1px;
    background: var(--text-white);
    color: #000;
    font-weight: bold;
    padding: 2px 8px;
    font-size: 0.8rem;
    border: 1px solid var(--border-color);
  }

  .action-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: 6px 6px 0 var(--text-white);
    background: var(--accent-purple);
  }

  .action-card:hover h3,
  .action-card:hover .arrow {
    color: #000;
  }

  .highlight-card {
    background: var(--text-white);
    border-color: var(--text-white);
  }

  .highlight-card h3,
  .highlight-card .arrow {
    color: #000;
  }

  .highlight-card .corner-tag {
    background: var(--accent-purple);
    color: #000;
  }

  .highlight-card:hover {
    background: var(--accent-purple);
    box-shadow: 6px 6px 0 var(--text-white);
  }

  .rulebook-divider {
    height: 2px;
    width: 100%;
    background: var(--accent-purple);
    margin-bottom: 4rem;
  }

  .payoff-section {
    margin-bottom: 4rem;
  }

  .payoff-intro {
    margin: -1.25rem 0 2.25rem;
    color: #a0a0a0;
    line-height: 1.6;
    max-width: 70ch;
    font-size: 1.05rem;
  }

  .payoff-intro strong {
    color: var(--text-white);
  }

  .payoff-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .payoff-card {
    padding: 1.5rem;
    background: #000;
  }

  .payoff-card h2 {
    margin: 0 0 1rem;
    color: var(--text-white);
    font-family: var(--font-mono);
    font-size: 1.1rem;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .payoff-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .payoff-table th,
  .payoff-table td {
    border: 1px solid var(--border-color);
    padding: 0.55rem 0.5rem;
    text-align: center;
    color: #a0a0a0;
  }

  .payoff-table thead th {
    color: var(--text-white);
    background: #111;
    font-size: 0.82rem;
    letter-spacing: 0.4px;
  }

  .payoff-table tbody th {
    color: var(--text-white);
    font-weight: bold;
    white-space: nowrap;
    font-size: 0.82rem;
    letter-spacing: 0.4px;
  }

  .section-label {
    font-family: var(--font-mono);
    color: var(--text-white);
    font-size: 1.5rem;
    font-weight: bold;
    margin-bottom: 3rem;
    letter-spacing: 2px;
    position: relative;
    z-index: 2;
  }

  .rulebook {
    position: relative;
  }

  .rulebook-decor {
    position: absolute;
    top: -2%;
    right: -15%;
    width: 400px;
    opacity: 0.15;
    z-index: 0;
    pointer-events: none;
    mix-blend-mode: color-dodge;
    rotate: -90deg;
  }

  .chess-board-img {
    width: 100%;
    height: auto;
  }

  .rules-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .rule-card {
    padding: 2.5rem;
    background: #000;
    position: relative;
    z-index: 2;
  }

  .offset-full {
    grid-column: 1 / -1;
  }

  .rule-tag {
    position: absolute;
    top: -15px;
    left: 20px;
    background: var(--text-white);
    color: #000;
    padding: 4px 12px;
    font-weight: bold;
    font-size: 0.9rem;
    letter-spacing: 2px;
  }

  .rule-card h2 {
    font-size: 2rem;
    color: var(--text-white);
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
    text-transform: uppercase;
  }

  .rule-card p {
    color: #a0a0a0;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
  }

  .rule-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rule-list li {
    font-family: var(--font-mono);
    color: #a0a0a0;
    line-height: 1.5;
    padding-left: 1.5rem;
    position: relative;
  }

  .rule-list li::before {
    content: ">";
    position: absolute;
    left: 0;
    color: var(--accent-purple);
    font-weight: bold;
  }

  .rule-list li strong {
    color: var(--text-white);
  }

  @media (max-width: 900px) {
    .page-container {
      padding: 115px 1.75rem 3.5rem;
    }

    .rules-grid {
      grid-template-columns: 1fr;
    }

    .payoff-grid {
      grid-template-columns: 1fr;
    }

    .rulebook-decor {
      width: 260px;
      right: -10%;
    }
  }

  @media (max-width: 768px) {
    .header-box {
      margin-bottom: 3rem;
    }

    .actions-grid {
      gap: 1.6rem;
      margin-bottom: 4rem;
    }

    h1 {
      font-size: 2.5rem;
    }

    .action-card {
      padding: 1.8rem 1.4rem;
    }

    .rule-card {
      padding: 1.8rem 1.4rem;
    }

    .rule-card h2 {
      font-size: 1.4rem;
    }

    .rule-card p,
    .rule-list li {
      font-size: 0.95rem;
    }

    .payoff-intro {
      font-size: 0.95rem;
      margin-bottom: 1.75rem;
    }

    .payoff-card {
      padding: 1rem;
    }

    .payoff-table {
      font-size: 0.82rem;
    }

    .payoff-table th,
    .payoff-table td {
      padding: 0.5rem 0.35rem;
    }

    .section-label {
      font-size: 1.2rem;
    }
  }

  @media (max-width: 480px) {
    .page-container {
      padding: 110px 1.1rem 3rem;
    }

    .header-box {
      padding: 1.5rem 1rem;
    }

    h1 {
      font-size: 1.7rem;
      letter-spacing: 2px;
    }

    .subtitle {
      font-size: 0.9rem;
      letter-spacing: 1px;
    }

    .actions-grid {
      gap: 1.5rem;
      margin-bottom: 3.5rem;
    }

    .action-card h3 {
      font-size: 1rem;
    }

    .arrow {
      font-size: 1.1rem;
    }

    .rulebook-decor {
      display: none;
    }

    .rule-tag {
      left: 12px;
      font-size: 0.75rem;
      letter-spacing: 1px;
    }

    .rule-list {
      gap: 1.25rem;
    }
  }
</style>
