    <!-- SECTION 3: ENVIRONMENT-BY-ENVIRONMENT BREAKDOWNS & SCORE MATRICES -->
    <section class="env-section-container" aria-label="Environment Standings and Score Matrices">
      <div class="header-box brutalist-block">
        <h2>ENVIRONMENT STANDINGS & SCORE MATRICES</h2>
        <p class="subtitle">> INDIVIDUAL PAYOFF TABLES & HEAD-TO-HEAD MATRICES</p>
      </div>

      <!-- Filter Controls for Environments -->
      <div class="filter-controls brutalist-block">
        <span class="filter-label">FILTER ENVIRONMENT:</span>
        <button class="filter-btn active" data-filter="all">ALL ENVIRONMENTS</button>
        <button class="filter-btn" data-filter="env-cpd">CPD</button>
        <button class="filter-btn" data-filter="env-bos">BOS</button>
        <button class="filter-btn" data-filter="env-vd">VD</button>
        <button class="filter-btn" data-filter="env-inv">INV_PD</button>
        <button class="filter-btn" data-filter="env-allb">ALL_B</button>
