          <text x="50" y="110" fill="#888" font-size="10" font-family="monospace" text-anchor="end">+3.0</text>
          <text x="50" y="280" fill="#888" font-size="10" font-family="monospace" text-anchor="end">-2.0</text>
          <line x1="60" y1="105" x2="770" y2="105" stroke="rgba(255,255,255,0.1)" stroke-dasharray="2 2" />
          <line x1="60" y1="275" x2="770" y2="275" stroke="rgba(255,255,255,0.1)" stroke-dasharray="2 2" />

          <!-- Group 1: CPD -->
          <text x="140" y="300" fill="#ba8fd8" font-size="11" font-family="monospace" font-weight="bold" text-anchor="middle">CPD</text>
          <rect x="75" y="113.75" width="18" height="96.25" fill="#ba8fd8" />
          <rect x="96" y="156.45" width="18" height="53.55" fill="#8146a8" />
          <rect x="117" y="113.75" width="18" height="96.25" fill="#ffffff" />
          <rect x="138" y="155.05" width="18" height="54.95" fill="#666666" />
          <rect x="159" y="147.7" width="18" height="62.3" fill="#444444" />
