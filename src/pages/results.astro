---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/common/Navbar.astro";
import Footer from "../components/common/Footer.astro";
---

<Layout
  title="Iteron | Tournament Results & Score Matrices"
  description="Iteron tournament results, overall head-to-head score matrix, individual environment standings, and interactive performance visualizations."
>
  <Navbar />

  <main class="page-container">
    <header class="header-box brutalist-block">
      <h1 class="glitch" data-text="TOURNAMENT_RESULTS">TOURNAMENT_RESULTS</h1>
      <p class="subtitle">> LEADERBOARD, SCORE MATRICES & ENVIRONMENT ANALYSIS</p>
    </header>

    <!-- Winner Announcement Banner -->
    <section class="winner-announcement brutalist-block">
      <div class="winner-badge">TOURNAMENT WINNER DECLARED</div>
      <h2>CONGRATULATIONS TO PYTHIA OF DELPHI!</h2>
      <p>
        Evaluated across five distinct strategic payoff environments,
        <strong>Pythia of Delphi</strong> achieved the highest total score of
        <strong>27,873.4 points</strong>, demonstrating exceptional resilience and adaptive strength.
      </p>
    </section>

    <!-- Podium Top 3 Cards -->
    <section class="podium-grid" aria-label="Top 3 Standings">
      <div class="podium-card brutalist-block rank-1">
        <div class="rank-tag">1ST PLACE</div>
        <h3>Pythia of Delphi</h3>
        <div class="score-num">27,873.4 <span class="score-unit">PTS</span></div>
        <p class="rank-desc">
          2nd-order Markov engine with exponential memory decay (`0.95`). Dominant in Inverted PD & All Bad.
        </p>
      </div>

      <div class="podium-card brutalist-block rank-2">
        <div class="rank-tag">2ND PLACE</div>
        <h3>AntiCoord_UniBonn</h3>
        <div class="score-num">25,998.4 <span class="score-unit">PTS</span></div>
        <p class="rank-desc">
          Anti-coordination specialist. Swept #1 in both Battle of Sexes and Volunteer's Dilemma.
        </p>
      </div>

      <div class="podium-card brutalist-block rank-3">
        <div class="rank-tag">3RD PLACE</div>
        <h3>Look at the Upshots!</h3>
        <div class="score-num">20,288.6 <span class="score-unit">PTS</span></div>
        <p class="rank-desc">
          High initial cooperation engine. Ranked #1 median scorer in Classical Prisoner's Dilemma.
        </p>
      </div>
    </section>

    <!-- Overall Leaderboard Table -->
    <section class="results-section brutalist-block" aria-labelledby="global-leaderboard-heading">
      <div class="section-tag">[ GLOBAL STANDINGS ]</div>
      <h2 id="global-leaderboard-heading">Overall Leaderboard</h2>
      <p class="section-subtext">Combined scores accumulated across all 5 payoff matrix environments.</p>

      <div class="table-responsive-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Rank</th>
              <th>Strategy Name</th>
              <th>Total Score</th>
              <th>Best Environment</th>
              <th>ENV Wins</th>
            </tr>
          </thead>
          <tbody>
            <tr class="highlight-row-1">
              <td class="bold-cell">1</td>
              <td class="name-cell">Pythia of Delphi</td>
              <td class="score-cell">27,873.4</td>
              <td>Inverted PD & All Bad</td>
              <td>2 ENVs</td>
            </tr>
            <tr class="highlight-row-2">
              <td class="bold-cell">2</td>
              <td class="name-cell">AntiCoord_UniBonn</td>
              <td class="score-cell">25,998.4</td>
              <td>Battle of Sexes & Volunteer's Dilemma</td>
              <td>2 ENVs</td>
            </tr>
            <tr class="highlight-row-3">
              <td class="bold-cell">3</td>
              <td class="name-cell">Look at the Upshots!</td>
              <td class="score-cell">20,288.6</td>
              <td>Classical Prisoner's Dilemma</td>
              <td>1 ENV</td>
            </tr>
            <tr>
              <td class="bold-cell">4</td>
              <td class="name-cell">Gradient_Pressure</td>
              <td class="score-cell">19,139.0</td>
              <td>Inverted PD (#2)</td>
              <td>0 ENVs</td>
            </tr>
            <tr>
              <td class="bold-cell">5</td>
              <td class="name-cell">decaying_trust</td>
              <td class="score-cell">8,231.4</td>
              <td>Classical PD (#4)</td>
              <td>0 ENVs</td>
            </tr>
            <tr>
              <td class="bold-cell">6</td>
              <td class="name-cell">Zone_Adaptive_Pressure</td>
              <td class="score-cell">6,995.2</td>
              <td>Classical PD (#3)</td>
              <td>0 ENVs</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- OVERALL HEAD-TO-HEAD SCORE MATRIX TABLE -->
      <div class="matrix-heading-box">
        <h3 class="sub-heading">Overall Head-to-Head Score Matrix (Sum Across All 5 ENVs)</h3>
        <p class="matrix-info">Cumulative points earned by Row Player vs Column Opponent across all 5 environments:</p>
      </div>

      <div class="table-responsive-wrapper matrix-compact-wrapper">
        <table class="matrix-table compact-matrix">
          <thead>
            <tr>
              <th>Player \ Opponent</th>
              <th>AntiCoord</th>
              <th>decaying</th>
              <th>Gradient</th>
              <th>Upshots</th>
              <th>Pythia</th>
              <th>Zone</th>
              <th>Avg Score</th>
            </tr>
          </thead>
          <tbody>
            <tr class="highlight-row-1">
              <td class="player-header">Pythia of Delphi</td>
              <td>15.52</td><td>9.79</td><td>15.23</td><td>11.80</td><td>15.00</td><td>3.37</td>
              <td class="score-cell">11.78</td>
            </tr>
            <tr class="highlight-row-2">
              <td class="player-header">AntiCoord_UniBonn</td>
              <td class="neg-score">-3.52</td><td>11.77</td><td>10.94</td><td>11.01</td><td>12.69</td><td>5.61</td>
              <td class="score-cell">8.09</td>
            </tr>
            <tr class="highlight-row-3">
              <td class="player-header">Look at the Upshots!</td>
              <td>17.85</td><td class="neg-score">-6.68</td><td>16.96</td><td class="neg-score">-0.33</td><td>13.77</td><td class="neg-score">-1.31</td>
              <td class="score-cell">6.71</td>
            </tr>
            <tr>
              <td class="player-header">Gradient_Pressure</td>
              <td>11.59</td><td>2.63</td><td class="neg-score">-0.03</td><td>10.40</td><td>10.47</td><td>3.20</td>
              <td class="score-cell">6.37</td>
            </tr>
            <tr>
              <td class="player-header">decaying_trust</td>
              <td>9.75</td><td>2.00</td><td>3.99</td><td class="neg-score">-6.66</td><td>3.64</td><td>5.78</td>
              <td class="score-cell">3.09</td>
            </tr>
            <tr>
              <td class="player-header">Zone_Adaptive_Pressure</td>
              <td>5.64</td><td>5.18</td><td>3.37</td><td class="neg-score">-2.83</td><td>2.63</td><td>2.03</td>
              <td class="score-cell">2.67</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="leaderboard-issue-row">
        <a href="#results-usage-policy" class="issue-report-link">
          ↳ Found an error or discrepancy? Report an Issue
        </a>
      </div>
    </section>

    <!-- CUSTOM THEME GRAPH 1: Responsive SVG Overall Score Chart -->
    <section class="results-section brutalist-block" aria-labelledby="overall-chart-heading">
      <div class="section-tag">[ DATA VISUALIZATION ]</div>
      <h2 id="overall-chart-heading">Total Score Breakdown Chart</h2>
      <p class="section-subtext">Total points accumulated across all five strategic payoff environments.</p>

      <div class="svg-chart-container">
        <svg viewBox="0 0 800 380" class="theme-svg-chart" aria-label="Overall Total Score Bar Chart">
          <!-- Background Grid Lines -->
          <line x1="180" y1="40" x2="180" y2="310" stroke="rgba(255,255,255,0.2)" stroke-dasharray="4 4" />
          <line x1="330" y1="40" x2="330" y2="310" stroke="rgba(255,255,255,0.1)" stroke-dasharray="4 4" />
          <line x1="480" y1="40" x2="480" y2="310" stroke="rgba(255,255,255,0.1)" stroke-dasharray="4 4" />
          <line x1="630" y1="40" x2="630" y2="310" stroke="rgba(255,255,255,0.1)" stroke-dasharray="4 4" />
          <line x1="780" y1="40" x2="780" y2="310" stroke="rgba(255,255,255,0.2)" stroke-dasharray="4 4" />

          <!-- X-Axis Labels -->
          <text x="180" y="335" fill="#888" font-size="11" font-family="monospace" text-anchor="middle">0</text>
          <text x="330" y="335" fill="#888" font-size="11" font-family="monospace" text-anchor="middle">7.5k</text>
          <text x="480" y="335" fill="#888" font-size="11" font-family="monospace" text-anchor="middle">15k</text>
          <text x="630" y="335" fill="#888" font-size="11" font-family="monospace" text-anchor="middle">22.5k</text>
          <text x="780" y="335" fill="#888" font-size="11" font-family="monospace" text-anchor="middle">30k</text>

          <!-- Bars and Labels -->
          <text x="165" y="65" fill="#ffffff" font-size="12" font-family="monospace" font-weight="bold" text-anchor="end">Pythia of Delphi</text>
          <rect x="180" y="48" width="557" height="26" fill="#ba8fd8" stroke="#ffffff" stroke-width="1" />
          <text x="744" y="65" fill="#ba8fd8" font-size="12" font-family="monospace" font-weight="bold">27,873.4</text>

          <text x="165" y="110" fill="#ffffff" font-size="12" font-family="monospace" font-weight="bold" text-anchor="end">AntiCoord_UniBonn</text>
          <rect x="180" y="93" width="520" height="26" fill="#8146a8" stroke="#ffffff" stroke-width="1" />
          <text x="707" y="110" fill="#ba8fd8" font-size="12" font-family="monospace" font-weight="bold">25,998.4</text>

          <text x="165" y="155" fill="#ffffff" font-size="12" font-family="monospace" text-anchor="end">Look at Upshots!</text>
          <rect x="180" y="138" width="405" height="26" fill="#ba8fd8" opacity="0.8" stroke="#ffffff" stroke-width="1" />
          <text x="592" y="155" fill="#ffffff" font-size="12" font-family="monospace">20,288.6</text>

          <text x="165" y="200" fill="#ffffff" font-size="12" font-family="monospace" text-anchor="end">Gradient_Pressure</text>
          <rect x="180" y="183" width="382" height="26" fill="#8146a8" opacity="0.8" stroke="#ffffff" stroke-width="1" />
          <text x="569" y="200" fill="#ffffff" font-size="12" font-family="monospace">19,139.0</text>

          <text x="165" y="245" fill="#ffffff" font-size="12" font-family="monospace" text-anchor="end">decaying_trust</text>
          <rect x="180" y="228" width="164" height="26" fill="#555555" stroke="#ffffff" stroke-width="1" />
          <text x="351" y="245" fill="#ffffff" font-size="12" font-family="monospace">8,231.4</text>

          <text x="165" y="290" fill="#ffffff" font-size="12" font-family="monospace" text-anchor="end">Zone_Adaptive</text>
          <rect x="180" y="273" width="140" height="26" fill="#333333" stroke="#ffffff" stroke-width="1" />
          <text x="327" y="290" fill="#ffffff" font-size="12" font-family="monospace">6,995.2</text>
        </svg>
      </div>
    </section>

