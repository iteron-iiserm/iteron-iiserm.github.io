---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/common/Navbar.astro";
import Footer from "../components/common/Footer.astro";
---

<Layout
  title="Iteron | Results"
  description="Track Iteron tournament outcomes, rankings, and result announcements."
>
  <Navbar />

  <main class="page-container">
    <div class="header-box brutalist-block">
      <h1 class="glitch" data-text="TOURNAMENT_RESULTS">TOURNAMENT_RESULTS</h1>
      <p class="subtitle">> SIMULATION OUTCOMES & STRATEGY RANKINGS</p>
    </div>

    <div class="pending-state brutalist-block">
      <div class="quote-box">
        <p>
          "The foundation of cooperation is not really trust, but the durability
          of the relationship."
        </p>
        <span class="quote-author">- Robert Axelrod</span>
      </div>

      <h2>RESULTS ANNOUNCEMENT: AUGUST 10TH, 2026</h2>
      <p>
        Submissions for Iteron are now closed (Deadline: July 31st, 2026).
        The simulation rounds across all multi-environment payoff matrices are currently being computed.
        Official tournament results and global rankings will be declared on <strong>August 10th, 2026</strong>.
      </p>
      <p>
        After the official result declaration, all submitted strategies and simulation outcomes will be
        made public. Anyone will be free to study, extend, and use them for further research.
      </p>
      <p>
        Stay tuned on the <a
          href="/updates"
          class="inline-link">UPDATES</a
        > page for further announcements.
      </p>
    </div>

    <section class="usage-notice brutalist-block" aria-labelledby="results-usage-policy">
      <h2 id="results-usage-policy">Data and Content Usage Notice</h2>
      <ul>
        <li>Participant submissions remain the intellectual property of their creators.</li>
        <li>
          Published strategy data is shared under
          <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="noopener noreferrer">CC BY-NC 4.0</a>
          for research and educational reuse with attribution to the creator and Iteron.
        </li>
        <li>
          Infographics, analyses, and reports produced by Turing Club/core organizers are organizer-owned
          and, unless a page states otherwise, are also shared under
          <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="noopener noreferrer">CC BY-NC 4.0</a>.
        </li>
      </ul>
      <p>
        For full legal terms, read
        <a href="/terms-of-use" class="inline-link">Terms of Use</a>,
        <a href="/privacy-policy" class="inline-link">Privacy Policy</a>, and
        <a href="/takedown-policy" class="inline-link">Takedown Policy</a>.
      </p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-container {
    padding: 120px 5% 5rem;
    max-width: 1000px;
    margin: 0 auto;
    min-height: 100vh;
  }

  .header-box {
    margin-bottom: 4rem;
    padding: 2rem;
    background: #000;
    text-align: center;
    border-color: var(--accent-purple);
  }

  h1 {
    font-size: 3.5rem;
    color: var(--text-white);
    margin-bottom: 1rem;
    font-family: var(--font-display);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .subtitle {
    color: var(--accent-purple);
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .pending-state {
    padding: 4rem 2rem;
    background: #000;
    text-align: center;
    position: relative;
    border-color: var(--text-white);
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
  }

  .chair-decor {
    position: absolute;
    bottom: -20px;
    right: -20px;
    width: 300px;
    opacity: 0.3;
    pointer-events: none;
    z-index: 0;
    mix-blend-mode: screen;
  }

  .chair-img {
    width: 100%;
    height: auto;
    filter: invert(1);
  }

  .pending-state h2,
  .pending-state p,
  .quote-box {
    position: relative;
    z-index: 2;
  }

  .pending-state h2 {
    font-size: 2.5rem;
    color: var(--text-white);
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
    letter-spacing: 4px;
  }

  .pending-state p {
    color: #a0a0a0;
    line-height: 1.6;
    margin-bottom: 2.5rem;
    font-size: 1.1rem;
    max-width: 600px;
  }

  .deadline-line {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .deadline-old {
    display: inline-block;
    position: relative;
    font-weight: 700;
    /* color: var(--text-white); */
    padding: 0 0.1rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  .deadline-old::after {
    content: "";
    position: absolute;
    width: calc(100% + 0.3rem);
    left: -0.15rem;
    top: 50%;
    height: 2px;
    background: var(--accent-purple);
    transform: translateY(-50%) rotate(-5deg);
    box-shadow: 0 0 8px rgba(186, 143, 216, 0.5);
    pointer-events: none;
  }

  .deadline-arrow {
    color: var(--accent-purple);
    font-weight: 700;
  }

  .deadline-new {
    color: var(--text-white);
    font-weight: 700;
  }

  .usage-notice {
    margin-top: 2rem;
    border-color: var(--text-white);
  }

  .usage-notice h2 {
    font-size: 1.5rem;
    margin-bottom: 0.9rem;
    letter-spacing: 1px;
  }

  .usage-notice ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-bottom: 0.8rem;
  }

  .usage-notice li {
    color: #b9b9b9;
    padding-left: 1.2rem;
    position: relative;
    line-height: 1.55;
  }

  .usage-notice li::before {
    content: ">";
    position: absolute;
    left: 0;
    color: var(--accent-purple);
    font-weight: bold;
  }

  .usage-notice p {
    color: #b9b9b9;
    margin-bottom: 0;
    max-width: 700px;
  }

  .quote-box {
    margin-bottom: 3rem;
    padding: 2rem;
    border-left: 4px solid var(--accent-purple);
    background: rgba(186, 143, 216, 0.05);
    max-width: 800px;
    text-align: left;
  }

  .quote-box p {
    font-size: 1.4rem;
    font-style: italic;
    color: var(--text-white);
    margin-bottom: 1rem;
    line-height: 1.6;
    font-family: var(--font-display);
  }

  .quote-author {
    color: var(--accent-purple);
    font-family: var(--font-mono);
    font-weight: bold;
    letter-spacing: 1px;
  }

  .inline-link {
    color: var(--accent-purple);
    text-decoration: none;
    font-weight: bold;
    border-bottom: 1px solid transparent;
    transition: all 0.2s;
  }

  .inline-link:hover {
    color: #000;
    background: var(--accent-purple);
    border-bottom-color: var(--accent-purple);
  }

  .inline-link:focus-visible {
    color: #000;
    background: var(--accent-purple);
    border-bottom-color: var(--accent-purple);
    outline: 2px solid var(--accent-purple);
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .page-container {
      padding: 110px 1.25rem 3.75rem;
    }

    h1 {
      font-size: 2.5rem;
    }

    .pending-state {
      padding: 2.4rem 1.4rem;
    }

    .pending-state h2 {
      font-size: 1.8rem;
      letter-spacing: 2px;
    }

    .quote-box {
      padding: 1.25rem;
      margin-bottom: 2rem;
    }

    .quote-box p {
      font-size: 1.1rem;
    }
  }

  @media (max-width: 480px) {
    h1 {
      font-size: 1.5rem;
      letter-spacing: 1px;
      line-height: 1.15;
    }

    .subtitle {
      font-size: 0.9rem;
      letter-spacing: 1px;
      line-height: 1.5;
    }

    .pending-state p {
      font-size: 1rem;
      margin-bottom: 1.5rem;
      line-height: 1.8;
    }
  }
</style>
