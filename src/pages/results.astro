      <h2 id="multi-env-chart-heading">Median Score Across Payoff Environments</h2>
      <p class="section-subtext">Comparing strategy median scores across CPD, BOS, VD, Inv_PD, and All_B.</p>

      <div class="svg-chart-container">
        <svg viewBox="0 0 800 320" class="theme-svg-chart" aria-label="Environment Median Score Comparison Chart">
          <!-- Baseline Zero Line -->
          <line x1="60" y1="210" x2="770" y2="210" stroke="#ffffff" stroke-width="1.5" />
