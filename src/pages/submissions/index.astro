---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/common/Navbar.astro";
import Footer from "../../components/common/Footer.astro";
import { Image } from "astro:assets";
import chessBoardImg from "../../assets/chess-board.png";
---

<Layout
  title="Iteron | Submissions Closed"
  description="Submissions for Iteron are now closed. Results will be declared on August 10th, 2026. Access official templates, payoff matrices, reference strategies, and rules."
>
  <Navbar />

  <main class="page-container">
    <header class="header-box brutalist-block">
      <h1 class="glitch" data-text="SUBMISSIONS">SUBMISSIONS</h1>
      <p class="subtitle">> SUBMISSION PORTAL & DOCUMENTATION</p>
    </header>

    <div class="submissions-closed-banner brutalist-block">
      <h2>SUBMISSIONS ARE NOW CLOSED</h2>
      <p>
        The submission deadline for Iteron (July 31st, 2026) has passed. Strategy submissions are no longer being accepted.
      </p>
      <div class="results-date-box">
        <span>OFFICIAL RESULTS DECLARATION:</span>
        <strong>AUGUST 10TH, 2026</strong>
      </div>
      <a href="/results" class="btn-results">[ TRACK TOURNAMENT RESULTS ]</a>
    </div>

    <div class="actions-grid">
      <div class="action-card brutalist-block closed-card">
        <span class="corner-tag">[ 01 ]</span>
        <h3>SUBMISSIONS CLOSED</h3>
        <span class="closed-tag">CLOSED</span>
      </div>

      <a
        href="https://colab.research.google.com/drive/1WoadT0bsvaYXMZ5XHBvmEQie7rZf9v8f?usp=sharing"
        target="_blank"
        rel="noopener noreferrer"
        class="action-card brutalist-block"
      >
        <span class="corner-tag">[ 02 ]</span>
        <h3>STRATEGY TEMPLATE</h3>
        <span class="arrow">-></span>
      </a>

      <a
        href="/submissions/payoff"
        class="action-card brutalist-block"
      >
        <span class="corner-tag">[ 03 ]</span>
        <h3>PAYOFF MATRICES</h3>
        <span class="arrow">-></span>
      </a>

      <a
        href="/submissions/reference-strategies"
        class="action-card brutalist-block"
      >
        <span class="corner-tag">[ 04 ]</span>
        <h3>REFERENCE STRATEGIES</h3>
        <span class="arrow">-></span>
      </a>
    </div>

    <section class="legal-notice brutalist-block" aria-labelledby="submission-legal-notice">
      <h2 id="submission-legal-notice">Submission Rights and Consent Notice</h2>
      <p>
        By submitting through the official form, you confirm that the strategy is your original work
        and that you have the right to publish it.
      </p>
      <ul class="rule-list">
        <li>You retain ownership of your submitted strategy and related content.</li>
        <li>
          You grant Turing Club/core organizers a non-exclusive license to host, evaluate,
          archive, and publish your submission for tournament operations and public research access.
        </li>
        <li>
          Published submission data will be shared under
          <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="noopener noreferrer">CC BY-NC 4.0</a>
          for research and educational reuse with attribution to the creator and Iteron.
        </li>
        <li>
          Similar strategies may be independently created; where independent creation is reasonably established,
          credit may be granted to all independent creators.
        </li>
        <li>
          Plagiarism or copyright claims must include sufficient supporting proof for organizer review.
        </li>
      </ul>
      <p class="legal-links">
        Read the full
        <a href="/terms-of-use">Terms of Use</a>,
        <a href="/privacy-policy">Privacy Policy</a>, and
        <a href="/takedown-policy">Takedown Policy</a> before submitting.
      </p>
    </section>

    <div class="rulebook-divider"></div>

    <section class="rulebook">
      <div class="rulebook-decor">
        <Image
          src={chessBoardImg}
          alt="Chess Board Decor"
          class="chess-board-img"
        />
      </div>
      <div class="section-label">OFFICIAL RULEBOOK</div>

      <div class="rules-grid">
        <div class="rule-card brutalist-block offset-full">
          <div class="rule-tag">OVERVIEW</div>
          <h2>General Information</h2>
          <p>
            A round-robin computational tournament designed to evaluate
            strategies across a variety of strategic environments using
            cumulative payoffs. Inspired by Robert Axelrod's Iterated Prisoner's
            Dilemma Tournament, this event tests the robustness of strategies
            across varying environments rather than a single static payoff
            matrix.
          </p>
          <ul class="rule-list">
            <li>
              <strong>Format:</strong> Round-robin computational tournament, conducted
              online.
            </li>
            <li>
              <strong>Eligibility:</strong> Open to all students and faculty affiliated with any recognized university.
            </li>
            <li>
              <strong>Status:</strong> Submissions are closed (Deadline was July 31st, 2026 11:59 PM IST).
            </li>
            <li>
              <strong>Results Declaration:</strong> Results will be declared on August 10th, 2026.
            </li>
          </ul>
        </div>

        <div class="rule-card brutalist-block offset-full">
          <div class="rule-tag">SECTION_01</div>
          <h2>Introduction</h2>
          <p>
            Welcome to the Iteron. Participants are required to submit
            code-based strategies to compete against one another. Unlike the
            conventional tournament, this event tests the robustness of
            strategies across varying environments.
          </p>
        </div>

        <div class="rule-card brutalist-block offset-full">
          <div class="rule-tag">SECTION_02</div>
          <h2>Strategy Originality & Structure</h2>
          <ul class="rule-list">
            <li>
              Every submission must be original. Pre-made strategies and
              near-clones are prohibited.
            </li>
            <li>
              Your strategy must not be behaviourally similar to strategies from
              the
              <a
                href="https://axelrod.readthedocs.io/en/stable/reference/strategy_index.html"
                target="_blank"
                rel="noopener noreferrer"
              >Axelrod Strategy Index</a>,
              and it must also be distinct from <strong>Tit For Tat</strong>.
            </li>
            <li>
              Similarity checks are behavioural: changing variable names,
              comments, or code structure alone does not make a strategy
              original.
            </li>
            <li>
              See the organizer-maintained reference list at
              <a href="/submissions/reference-strategies">/submissions/reference-strategies</a>
              for quick checks before submission.
            </li>
          </ul>
        </div>

        <div class="rule-card brutalist-block">
          <div class="rule-tag">SECTION_03</div>
          <h2>Formatting & Templates</h2>
          <ul class="rule-list">
            <li>
              Strategies must be submitted using the <strong
                >official template</strong
              > provided by the organizers.
            </li>
            <li>
              Submissions in any other format or structure will be rejected.
              Participants may be asked to resubmit in the correct format or
              face immediate disqualification.
            </li>
          </ul>
        </div>

        <div class="rule-card brutalist-block">
          <div class="rule-tag">SECTION_04</div>
          <h2>Testing</h2>
          <ul class="rule-list">
            <li>
              To prevent runtime errors during the actual tournament, the
              organizers have released a Sample Strategy.
            </li>
            <li>
              You are required to test your code against this sample strategy
              before submission.
            </li>
            <li>
              Any additional information regarding the same will be communicated
              via mail.
            </li>
          </ul>
        </div>

        <div class="rule-card brutalist-block">
          <div class="rule-tag">SECTION_05</div>
          <h2>Technical Constraints</h2>
          <ul class="rule-list">
            <li>
              <strong>Machine Learning:</strong> The use of ML within strategies is
              expected to be limited. Strategies relying heavily on computationally
              expensive models may be subject to review regarding time-complexity
              limits.
            </li>
          </ul>
        </div>

        <div class="rule-card brutalist-block">
          <div class="rule-tag">SECTION_06</div>
          <h2>Tournament Structure</h2>
          <ul class="rule-list">
            <li>The tournament will be conducted in a Round Robin format.</li>
            <li>
              Every submitted strategy will play against every other opponent's
              strategy.
            </li>
            <li>
              Every submitted strategy will also play against a copy of itself.
            </li>
          </ul>
        </div>

        <div class="rule-card brutalist-block offset-full">
          <div class="rule-tag">SECTION_07</div>
          <h2>Match Duration & Iteration</h2>
          <ul class="rule-list">
            <li>
              To preserve the game-theoretic essence of the "Shadow of the
              Future," the exact number of rounds per match will not be revealed
              to participants.
            </li>
            <li>
              Strategies should be designed to handle an indefinite time
              horizon.
            </li>
            <li>
              The entire tournament will be iterated more than once to ensure
              statistical significance, remove noise, and guarantee fair
              observations of strategy performance.
            </li>
          </ul>
        </div>

        <div class="rule-card brutalist-block offset-full">
          <div class="rule-tag">SECTION_08</div>
          <h2>The Multi-Environment System</h2>
          <ul class="rule-list">
            <li>
              Unlike the conventional Axelrod's tournament which uses a static
              payoff matrix, this tournament will be conducted across multiple
              environments.
            </li>
            <li>
              The organizers will systematically vary the payoff matrices — the
              rewards for Cooperation and Defection — between tournament runs.
            </li>
            <li>
              Strategies must be robust enough to adapt to changes in
              incentives, rather than being over-fitted to a single payoff
              structure.
            </li>
            <li>
              Each submitted strategy will be evaluated in all organizer-provided
              payoff environments.
            </li>
            <li>
              During evaluation, strategies will not be told which payoff
              environment is currently active.
            </li>
            <li>
              Any attempt to branch behavior based on detecting or hard-coding
              a specific payoff environment is not allowed.
            </li>
            <li>
              Detailed payoff matrices are available at
              <a href="/submissions/payoff">/submissions/payoff</a>.
            </li>
          </ul>
        </div>

        <div class="rule-card brutalist-block offset-full">
          <div class="rule-tag">SECTION_09</div>
          <h2>Winner Determination & Aggregate Performance</h2>
          <ul class="rule-list">
            <li>
              The final winner will be determined based on the highest average
              score.
            </li>
            <li>
              For every payoff environment, each strategy will be run multiple
              times; the resulting score for that environment is the average of
              those runs.
            </li>
            <li>
              The final score is then computed by averaging performance across
              all provided payoff environments.
            </li>
            <li>
              Consistency is key. Even if a strategy places 1st in k out of n
              specific matrix environments, it will receive no special
              consideration if its overall average drops due to poor performance
              in other environments.
            </li>
            <li>
              Final ranking is based solely on overall aggregated performance.
              No separate claims or titles will be awarded for individual
              sub-tournament wins.
            </li>
            <li>
              The ITERON team reserves the right to modify these rules to ensure
              the smooth operation of the tournament. Updates will be
              communicated via official channels.
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-container {
    padding: 120px 5% 5rem;
    max-width: 1200px;
    margin: 0 auto;
    min-height: 100vh;
  }

  .header-box {
    margin-bottom: 4rem;
    padding: 3rem 2rem;
    background: #000;
    text-align: center;
    border-color: var(--accent-purple);
  }

  h1 {
    font-size: 3.5rem;
    color: var(--text-white);
    margin-bottom: 1rem;
    font-family: var(--font-display);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .subtitle {
    color: var(--accent-purple);
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .actions-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    margin-bottom: 6rem;
  }

  .action-card {
    padding: 2.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #000;
    text-decoration: none;
    position: relative;
    transition: all 0.2s;
  }

  .action-card h3 {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    color: var(--text-white);
    margin: 0;
  }

  .arrow {
    font-family: var(--font-mono);
    color: var(--accent-purple);
    font-size: 1.5rem;
    font-weight: bold;
  }

  .corner-tag {
    position: absolute;
    top: -12px;
    left: -1px;
    background: var(--text-white);
    color: #000;
    font-weight: bold;
    padding: 2px 8px;
    font-size: 0.8rem;
    border: 1px solid var(--border-color);
  }

  .action-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: 6px 6px 0 var(--text-white);
    background: var(--accent-purple);
  }

  .action-card:hover h3,
  .action-card:hover .arrow {
    color: #000;
  }

  .highlight-card {
    background: var(--text-white);
    border-color: var(--text-white);
  }

  .highlight-card h3,
  .highlight-card .arrow {
    color: #000;
  }

  .highlight-card .corner-tag {
    background: var(--accent-purple);
    color: #000;
  }

  .highlight-card:hover {
    background: var(--accent-purple);
    box-shadow: 6px 6px 0 var(--text-white);
  }

  .legal-notice {
    margin-top: -2rem;
    margin-bottom: 2.5rem;
    border-color: var(--text-white);
  }

  .legal-notice h2 {
    font-size: 1.15rem;
    margin-bottom: 0.8rem;
    letter-spacing: 1px;
  }

  .legal-notice p {
    color: #b9b9b9;
    margin-bottom: 0.85rem;
    line-height: 1.6;
  }

  .legal-links {
    margin-bottom: 0;
  }

  .legal-links a {
    font-weight: bold;
  }

  .rulebook-divider {
    height: 2px;
    width: 100%;
    background: var(--accent-purple);
    margin-bottom: 4rem;
  }

  .section-label {
    font-family: var(--font-mono);
    color: var(--text-white);
    font-size: 1.5rem;
    font-weight: bold;
    margin-bottom: 3rem;
    letter-spacing: 2px;
    position: relative;
    z-index: 2;
  }

  .rulebook {
    position: relative;
  }

  .rulebook-decor {
    position: absolute;
    top: -2%;
    right: -15%;
    width: 400px;
    opacity: 0.15;
    z-index: 0;
    pointer-events: none;
    mix-blend-mode: color-dodge;
    rotate: -90deg;
  }

  .chess-board-img {
    width: 100%;
    height: auto;
  }

  .rules-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .rule-card {
    padding: 2.5rem;
    background: #000;
    position: relative;
    z-index: 2;
  }

  .offset-full {
    grid-column: 1 / -1;
  }

  .rule-tag {
    position: absolute;
    top: -15px;
    left: 20px;
    background: var(--text-white);
    color: #000;
    padding: 4px 12px;
    font-weight: bold;
    font-size: 0.9rem;
    letter-spacing: 2px;
  }

  .rule-card h2 {
    font-size: 2rem;
    color: var(--text-white);
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
    text-transform: uppercase;
  }

  .rule-card p {
    color: #a0a0a0;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
  }

  .rule-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rule-list li {
    font-family: var(--font-mono);
    color: #a0a0a0;
    line-height: 1.5;
    padding-left: 1.5rem;
    position: relative;
  }

  .rule-list li::before {
    content: ">";
    position: absolute;
    left: 0;
    color: var(--accent-purple);
    font-weight: bold;
  }

  .rule-list li strong {
    color: var(--text-white);
  }

  @media (max-width: 900px) {
    .page-container {
      padding: 115px 1.75rem 3.5rem;
    }

    .rules-grid {
      grid-template-columns: 1fr;
    }

    .actions-grid {
      grid-template-columns: 1fr;
    }

    .rulebook-decor {
      width: 260px;
      right: -10%;
    }
  }

  @media (max-width: 768px) {
    .header-box {
      margin-bottom: 3rem;
    }

    .actions-grid {
      gap: 1.6rem;
      margin-bottom: 4rem;
    }

    h1 {
      font-size: 2.5rem;
    }

    .action-card {
      padding: 1.8rem 1.4rem;
    }

    .rule-card {
      padding: 1.8rem 1.4rem;
    }

    .rule-card h2 {
      font-size: 1.4rem;
    }

    .rule-card p,
    .rule-list li {
      font-size: 0.95rem;
    }

    .section-label {
      font-size: 1.2rem;
    }
  }

  @media (max-width: 480px) {
    .page-container {
      padding: 110px 1.1rem 3rem;
    }

    .header-box {
      padding: 1.5rem 1rem;
    }

    h1 {
      font-size: 1.7rem;
      letter-spacing: 2px;
    }

    .subtitle {
      font-size: 0.9rem;
      letter-spacing: 1px;
    }

    .actions-grid {
      gap: 1.5rem;
      margin-bottom: 3.5rem;
    }

    .action-card h3 {
      font-size: 1rem;
    }

    .arrow {
      font-size: 1.1rem;
    }

    .rulebook-decor {
      display: none;
    }

    .rule-tag {
      left: 12px;
      font-size: 0.75rem;
      letter-spacing: 1px;
    }

    .rule-list {
      gap: 1.25rem;
    }
  }

  .submissions-closed-banner {
    margin-bottom: 3rem;
    padding: 2.5rem;
    background: #000;
    border-color: var(--accent-purple);
    text-align: center;
    position: relative;
  }

  .notice-badge {
    display: inline-block;
    background: #ff4d4d;
    color: #fff;
    font-weight: bold;
    padding: 4px 12px;
    font-size: 0.85rem;
    letter-spacing: 2px;
    margin-bottom: 1rem;
    border: 1px solid #ff4d4d;
  }

  .submissions-closed-banner h2 {
    font-size: 2.2rem;
    color: var(--text-white);
    margin-bottom: 1rem;
  }

  .submissions-closed-banner p {
    color: #a0a0a0;
    font-size: 1.1rem;
    max-width: 700px;
    margin: 0 auto 1.5rem;
    line-height: 1.6;
  }

  .results-date-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    margin-bottom: 2rem;
    padding: 1rem;
    background: rgba(186, 143, 216, 0.1);
    border: 1px dashed var(--accent-purple);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .results-date-box span {
    color: #c8c8c8;
    font-size: 0.9rem;
    letter-spacing: 1px;
  }

  .results-date-box strong {
    color: var(--accent-purple);
    font-size: 1.4rem;
    letter-spacing: 2px;
  }

  .btn-results {
    display: inline-block;
    background: var(--text-white);
    color: #000;
    padding: 0.9rem 1.8rem;
    font-family: var(--font-mono);
    font-weight: bold;
    text-decoration: none;
    border: 2px solid var(--text-white);
    transition: all 0.2s;
    box-shadow: 4px 4px 0 var(--accent-purple);
  }

  .btn-results:hover {
    background: var(--accent-purple);
    color: #000;
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--text-white);
  }

  .closed-card {
    opacity: 0.85;
    background: #111;
    border-color: #555;
    cursor: not-allowed;
  }

  .closed-card:hover {
    transform: none;
    box-shadow: 4px 4px 0 var(--accent-purple);
    background: #111;
  }

  .closed-card:hover h3 {
    color: var(--text-white);
  }

  .closed-tag {
    font-family: var(--font-mono);
    color: #ff4d4d;
    font-size: 1.1rem;
    font-weight: bold;
    letter-spacing: 1px;
  }
</style>
