---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/common/Navbar.astro";
import Footer from "../../components/common/Footer.astro";

const referenceGroups = [
  {
    title: "Classic Baselines",
    strategies: [
      "Tit For Tat",
      "Cooperator",
      "Defector",
      "Alternator",
      "Random",
      "Cycler",
    ],
  },
  {
    title: "Memory-One / Reactive Family",
    strategies: [
      "Win-Stay Lose-Shift (Pavlov)",
      "Generous Tit For Tat",
      "Suspicious Tit For Tat",
      "Grudger",
      "Hard Tit For Tat",
      "Soft Tit For Tat",
    ],
  },
  {
    title: "Meta / Rule-Based Variants",
    strategies: [
      "Meta Majority",
      "Meta Winner",
      "Meta Hunter",
      "Handshake-style strategies",
      "Looker Up variants",
      "Finite state machine based strategies",
    ],
  },
];
---

<Layout
  title="Iteron | Reference Strategies"
  description="Reference strategy list for Iteron originality checks. Avoid behavioural similarity with Axelrod index strategies and Tit For Tat."
>
  <Navbar />

  <main class="page-container">
    <header class="header-box brutalist-block">
      <h1 class="glitch" data-text="REFERENCE STRATEGIES">REFERENCE STRATEGIES</h1>
      <p class="subtitle">> ORIGINALITY CHECK GUIDANCE</p>
    </header>

    <section class="notice brutalist-block" aria-labelledby="notice-title">
      <div class="notice-tag">READ FIRST</div>
      <h2 id="notice-title">What is disallowed?</h2>
      <p>
        Submissions must not be pre-made or behaviourally similar to known
        reference strategies.
      </p>
      <ul>
        <li>
          The full comparison set includes strategies listed in the
          <a
            href="https://axelrod.readthedocs.io/en/stable/reference/strategy_index.html"
            target="_blank"
            rel="noopener noreferrer"
          >Axelrod Strategy Index</a>
          plus <strong>Tit For Tat</strong>.
        </li>
        <li>
          The groups below are a quick organizer guide for participants; they
          are not an exhaustive legal safe-list.
        </li>
        <li>
          A tool (or set of tools) to check uniqueness will be published in the
          next few days.
        </li>
      </ul>
    </section>

    <section class="groups-grid" aria-label="Reference strategy groups">
      {referenceGroups.map((group) => (
        <article class="group-card brutalist-block">
          <h3>{group.title}</h3>
          <ul>
            {group.strategies.map((strategy) => (
              <li>{strategy}</li>
            ))}
          </ul>
        </article>
      ))}
    </section>

    <section class="cta-row">
      <a href="/submissions" class="cta brutalist-block">Back to Submissions</a>
      <a
        href="https://axelrod.readthedocs.io/en/stable/reference/strategy_index.html"
        target="_blank"
        rel="noopener noreferrer"
        class="cta brutalist-block"
      >
        Open Full Axelrod Index
      </a>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-container {
    padding: 120px 5% 5rem;
    max-width: 1200px;
    margin: 0 auto;
    min-height: 100vh;
  }

  .header-box {
    margin-bottom: 3rem;
    padding: 3rem 2rem;
    background: #000;
    text-align: center;
    border-color: var(--accent-purple);
  }

  h1 {
    font-size: 3rem;
    color: var(--text-white);
    margin-bottom: 1rem;
    font-family: var(--font-display);
    letter-spacing: 3px;
  }

  .subtitle {
    color: var(--accent-purple);
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .notice {
    position: relative;
    margin-bottom: 3rem;
    border-color: var(--text-white);
  }

  .notice-tag {
    position: absolute;
    top: -14px;
    left: 18px;
    background: var(--text-white);
    color: #000;
    padding: 4px 10px;
    font-size: 0.82rem;
    letter-spacing: 1px;
    font-weight: bold;
  }

  .notice h2 {
    font-size: 1.6rem;
    margin-bottom: 0.9rem;
  }

  .notice p {
    color: #bdbdbd;
    margin-bottom: 0.9rem;
  }

  .notice ul,
  .group-card ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .notice li,
  .group-card li {
    color: #a8a8a8;
    padding-left: 1.2rem;
    position: relative;
    line-height: 1.55;
  }

  .notice li::before,
  .group-card li::before {
    content: ">";
    position: absolute;
    left: 0;
    color: var(--accent-purple);
    font-weight: bold;
  }

  .groups-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.6rem;
    margin-bottom: 2.5rem;
  }

  .group-card {
    background: #000;
  }

  .group-card h3 {
    margin-bottom: 1rem;
    font-size: 1.2rem;
    letter-spacing: 1px;
  }

  .cta-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .cta {
    display: block;
    text-align: center;
    color: var(--text-white);
    font-family: var(--font-mono);
    font-weight: bold;
    letter-spacing: 1px;
    background: #000;
  }

  .cta:hover {
    color: #000;
    background: var(--accent-purple);
  }

  @media (max-width: 960px) {
    .groups-grid {
      grid-template-columns: 1fr;
    }

    .cta-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .page-container {
      padding: 115px 1.75rem 3.5rem;
    }

    h1 {
      font-size: 2.1rem;
      letter-spacing: 2px;
    }
  }

  @media (max-width: 480px) {
    .page-container {
      padding: 110px 1.1rem 3rem;
    }

    .header-box {
      padding: 1.6rem 1rem;
    }

    h1 {
      font-size: 1.5rem;
      letter-spacing: 1px;
    }
  }
</style>
