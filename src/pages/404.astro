---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
---

<Layout title="Iteron | 404 - Terminated">
  <Navbar />
  
  <main class="error-container">
    <div class="error-content brutalist-block">
      <div class="error-code glitch" data-text="404">404</div>
      <div class="header-bar">ERROR: NOT_FOUND</div>
      
      <h1 class="error-title">PAGE NOT FOUND</h1>
      
      <p class="error-message">
        > The requested resource could not be located on the server.
        Please verify the URL or return to the main directory.
      </p>

      <div class="button-group">
        <a href="/" class="btn-primary">[ RETURN TO HOME ]</a>
        <a href="/submissions" class="btn-secondary">[ SUBMISSIONS ]</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .error-container {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 100px 5%;
  }

  .error-content {
    max-width: 700px;
    width: 100%;
    text-align: center;
    padding: 4rem 2rem;
    background: #000;
    position: relative;
    border-color: var(--accent-purple);
  }

  .error-code {
    font-family: var(--font-display);
    font-size: 8rem;
    font-weight: 700;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 4px var(--accent-purple);
    margin-bottom: 2rem;
    text-shadow: 4px 4px 0 var(--text-white);
  }

  .header-bar {
    position: absolute;
    top: -15px;
    left: 20px;
    background: var(--text-white);
    color: #000;
    padding: 4px 12px;
    font-weight: bold;
    font-size: 0.9rem;
    letter-spacing: 2px;
  }

  .error-title {
    font-size: 2.5rem;
    color: var(--text-white);
    margin-bottom: 1.5rem;
    letter-spacing: 4px;
  }

  .error-message {
    font-size: 1.1rem;
    color: #a0a0a0;
    line-height: 1.6;
    margin-bottom: 3rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .button-group {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary, .btn-secondary {
    display: inline-block;
    padding: 1rem 1.5rem;
    font-family: var(--font-mono);
    font-weight: bold;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--text-white);
    color: #000;
    border: 2px solid var(--text-white);
    box-shadow: 4px 4px 0 var(--accent-purple);
  }

  .btn-primary:hover {
    background: #000;
    color: var(--text-white);
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--accent-purple);
  }

  .btn-secondary {
    background: #000;
    color: var(--accent-purple);
    border: 2px solid var(--accent-purple);
  }

  .btn-secondary:hover {
    background: var(--accent-purple);
    color: #000;
  }

  @media (max-width: 768px) {
    .error-container {
      padding: 110px 1.25rem 2.75rem;
      align-items: flex-start;
    }

    .error-content {
      padding: 2.8rem 1.25rem 2rem;
    }

    .error-code {
      font-size: 5rem;
    }

    .error-title {
      font-size: 1.8rem;
    }
  }

  @media (max-width: 480px) {
    .error-code {
      font-size: 4rem;
      -webkit-text-stroke: 2px var(--accent-purple);
    }

    .error-title {
      font-size: 1.4rem;
      letter-spacing: 2px;
    }

    .error-message {
      font-size: 1rem;
      margin-bottom: 1.75rem;
      line-height: 1.8;
    }

    .button-group {
      width: 100%;
      gap: 0.75rem;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      text-align: center;
      padding: 0.85rem 1rem;
    }
  }
</style>