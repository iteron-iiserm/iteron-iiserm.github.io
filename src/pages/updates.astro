---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
---

<Layout
  title="Iteron | Updates"
  description="Latest announcements, schedule changes, and official Iteron tournament updates from IISER Mohali."
>
  <Navbar />
  
  <main class="page-container">
    <div class="header-box brutalist-block">
      <h1 class="glitch" data-text="UPDATES">UPDATES</h1>
      <p class="subtitle">> LATEST ANNOUNCEMENTS & NEWS</p>
    </div>

    <div class="updates-feed">
      <div class="update-card brutalist-block">
        <div class="update-date">[ 2026.04.01 ]</div>
        <h3>TOURNAMENT INITIALIZATION</h3>
        <p>
          The tournament is now officially live. 
          The infrastructure is ready to receive and process your strategy codes.
        </p>
        <a href="/submissions" class="btn-primary">[ SUBMISSION PORTAL ]</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .page-container {
    padding: 120px 5% 5rem;
    max-width: 1000px;
    margin: 0 auto;
    min-height: 100vh;
  }

  .header-box {
    margin-bottom: 4rem;
    padding: 2rem;
    background: #000;
    text-align: center;
    border-color: var(--accent-purple);
  }

  h1 {
    font-size: 3.5rem;
    color: var(--text-white);
    margin-bottom: 1rem;
    font-family: var(--font-display);
    letter-spacing: 4px;
  }

  .subtitle {
    color: var(--accent-purple);
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .updates-feed {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .update-card {
    padding: 2.5rem;
    position: relative;
    background: #000;
  }

  .update-date {
    display: inline-block;
    background: var(--text-white);
    color: #000;
    padding: 4px 12px;
    font-weight: bold;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    letter-spacing: 2px;
  }

  .update-card h3 {
    font-size: 2rem;
    color: var(--text-white);
    margin-bottom: 1rem;
    font-family: var(--font-display);
  }

  .update-card p {
    color: #a0a0a0;
    line-height: 1.6;
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }

  .btn-primary {
    display: inline-block;
    background: var(--text-white);
    color: #000;
    padding: 0.8rem 1.5rem;
    font-family: var(--font-mono);
    font-weight: bold;
    text-decoration: none;
    border: 2px solid var(--text-white);
    transition: all 0.2s;
    box-shadow: 4px 4px 0 var(--accent-purple);
  }

  .btn-primary:hover {
    background: #000;
    color: var(--text-white);
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--accent-purple);
  }

  @media (max-width: 768px) {
    .page-container {
      padding: 110px 1.25rem 3.75rem;
    }

    h1 {
      font-size: 2.5rem;
    }

    .update-card {
      padding: 1.8rem 1.4rem;
    }

    .update-card h3 {
      font-size: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    h1 {
      font-size: 1.8rem;
      letter-spacing: 2px;
    }

    .subtitle {
      font-size: 0.9rem;
      letter-spacing: 1px;
    }

    .update-card p {
      font-size: 1rem;
      line-height: 1.8;
    }

    .btn-primary {
      width: 100%;
      text-align: center;
    }
  }
</style>