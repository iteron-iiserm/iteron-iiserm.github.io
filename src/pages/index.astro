---
import Navbar from "../components/common/Navbar.astro";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Iteron</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Almendra+SC&family=Cinzel:wght@454&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Playfair+Display:ital,wght@0,400;1,400&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      background-image: url("/images/bg5.jpeg");
      font-family: 'Playfair Display', serif;
    }

    .banner {
      height: 60vh;
      background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url("/images/Hand.jpeg");
      background-size: cover;
      background-position: center;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .overlay {
      height: 100%;
      display: grid;
      place-items: center;
      text-align: center;
      color: white;
    }

    .mainsecanim {
      opacity: 0;
      transform: translateY(20px);
      animation: fadeSlideIn 0.8s ease-out forwards;
    }

    @keyframes fadeSlideIn {
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeUp {
      to { opacity: 1; transform: translateY(0); }
    }

    .main-section {
      min-height: 20vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 40px 20px;
      color: #f0f7f8;
      font-family: 'Cinzel';
    }

    .slide-box {
      max-width: 600px;
      background: black;
      padding: 30px;
      border-radius: 8px;
      box-shadow: 0 0 40px rgba(128, 0, 255, 0.6);
    }

    .main-section2 {
      min-height: 1vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 50px 20px;
      color: #f0f7f8;
      font-family: 'Cinzel';
    }

    .slide-box2 {
      max-width: 600px;
      background: black;
      padding: 40px;
      border-radius: 8px;
    }
    .slide-box2:hover {
      box-shadow: 0 0 10px #a855f7, 0 0 25px #9333ea, 0 0 40px #7e22ce;
    }

    .legacy {
      max-width: 800px;
      margin: 80px auto;
      padding: 20px;
      color: #ffffff;
    }

    .legacy h1 {
      font-size: 3rem;
      margin-bottom: 10px;
      font-weight: 700;
      text-align: center;
    }

    .intro {
      font-size: 1.1rem;
      line-height: 1.7;
      color: #a9b4c2;
      margin-bottom: 40px;
      text-align: center;
    }
    .intro strong { color: #ffffff; }

    .points {
      display: flex;
      flex-direction: column;
      gap: 25px;
    }

    .point {
      display: flex;
      align-items: flex-start;
      gap: 15px;
    }

    .arrow {
      background: #000710;
      color: #9234cc;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 1.2rem;
    }

    .point h3 { margin: 0; font-size: 1.2rem; }
    .point p { margin: 5px 0 0; color: #94a3b8; font-size: 0.95rem; }

    .strategy-section {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 120px 8%;
      background: #05070d;
      color: white;
      gap: 80px;
    }

    .strategy-left {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      max-width: 500px;
    }

    .strategy-title {
      font-size: 5rem;
      line-height: 0.95;
      margin: 0;
      font-family: Cinzel;
      text-shadow: 0 0 5px rgba(150,0,255,0.7), 0 0 15px rgba(150,0,255,0.6), 0 0 30px rgba(150,0,255,0.5);
    }

    .accent { color: #5f1274; }

    .strategy-text {
      font-family: 'Playfair Display', serif;
      color: #ffffff;
      font-size: 1.2rem;
      margin: 40px 0;
    }

    .strategy-buttons {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .strategy-buttons a {
      color: white;
      text-decoration: none;
      border: 1px solid white;
      padding: 10px 24px;
      border-radius: 6px;
      transition: background 0.3s ease, color 0.3s ease;
    }

    .strategy-buttons a:hover {
      background: white;
      color: black;
    }

    .btn-primary {
      background: #a003b5;
      color: black;
      padding: 14px 28px;
      text-decoration: none;
      font-family: 'Inter', sans-serif;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .btn-primary:hover {
      box-shadow: 0 0 3px rgb(131,227,227), 0 0 16px rgba(227,220,220,0.8);
      transform: translateY(-8px) scale(1.02);
    }

    .btn-secondary {
      border: 1px solid #2c3350;
      padding: 14px 28px;
      text-decoration: none;
      color: #8d96b2;
      font-family: 'Inter', sans-serif;
      text-transform: uppercase;
    }

    .phase-section {
      width: 100%;
      padding: 10px 8%;
      background: #05070d;
      color: white;
      text-align: center;
      font-family: 'Inter', sans-serif;
      position: relative;
    }

    .phase-header {
      color: #f9f9fa;
      font-size: 1rem;
      letter-spacing: 3px;
      margin-bottom: 60px;
      font-family: Cinzel;
    }

    .phase-line {
      position: absolute;
      top: 180px;
      left: 10%;
      right: 10%;
      height: 1px;
      background: #1b223b;
      z-index: 0;
    }

    .phase-container {
      display: flex;
      justify-content: space-between;
      gap: 40px;
      position: relative;
      z-index: 1;
    }

    .phase { flex: 1; max-width: 220px; margin: 0 auto; }

    .phase-number {
      width: 80px;
      height: 80px;
      margin: 0 auto 20px;
      border: 1px solid #1b223b;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      color: #7d89c9;
      background: rgba(20,25,45,0.4);
      box-shadow: 0 0 10px rgba(168,85,247,0.25), 0 0 25px rgba(126,34,206,0.15);
    }

    .phase h3 { font-size: 0.9rem; letter-spacing: 2px; margin-bottom: 15px; }
    .phase p {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-size: 0.95rem;
      color: #8d96b2;
      line-height: 1.6;
    }

    .contact-section {
      max-width: 600px;
      margin: 60px auto 80px auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      text-align: center;
      opacity: 0;
      transform: translateY(20px);
      animation: fadeUp 0.8s ease forwards;
      animation-delay: 1.3s;
    }

    .contact-divider {
      display: flex;
      align-items: center;
      gap: 14px;
      width: 100%;
    }
    .contact-divider-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(to right, transparent, rgba(255,255,255,0.1), transparent);
    }
    .contact-divider-ornament {
      font-family: 'Cinzel', serif;
      color: rgba(255,255,255,0.3);
      font-size: 0.7rem;
      letter-spacing: 6px;
    }

    .contact-text {
      font-family: 'Cinzel', serif;
      font-style: italic;
      font-size: 0.85rem;
      letter-spacing: 2px;
      color: rgba(255,255,255,0.45);
      margin: 0;
    }

    .contact-email {
      font-family: 'Cinzel', serif;
      font-size: 0.95rem;
      letter-spacing: 3px;
      color: #ff69b4;
      text-decoration: none;
      border-bottom: 1px solid rgba(255,105,180,0.3);
      padding-bottom: 3px;
      transition: color 0.3s ease, border-color 0.3s ease, text-shadow 0.3s ease;
    }

    footer {
      text-align: center;
      padding: 30px;
      font-family: 'Cinzel', serif;
      font-size: 0.75rem;
      letter-spacing: 4px;
      color: rgba(255,255,255,0.2);
      border-top: 1px solid rgba(255,255,255,0.05);
    }

    h1 { font-size: 4rem; }
    p { font-size: 1.2rem; }

    /* ── Help Section ── */
    .help-section {
      width: 100%;
      background: #05070d;
      padding: 60px 8%;
    }

    .help-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 8px;
    }

    .help-badge {
      background: #1a0a2e;
      color: #a855f7;
      font-size: 11px;
      font-weight: 500;
      padding: 3px 10px;
      border-radius: 20px;
      letter-spacing: 0.04em;
      border: 0.5px solid #a855f7;
    }

    .help-title {
      font-size: 20px;
      font-weight: 500;
      color: #ffffff;
      margin: 0 0 6px;
      font-family: 'Cinzel', serif;
    }

    .help-subtitle {
      font-size: 15px;
      color: #8d96b2;
      line-height: 1.6;
      margin: 0 0 1.25rem;
      font-family: 'Playfair Display', serif;
    }

    .help-divider {
      border: none;
      border-top: 0.5px solid #1b223b;
      margin: 0 0 1.25rem;
    }

    .video-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 12px;
    }

    .video-card {
      background: #000;
      border: 0.5px solid #1b223b;
      border-radius: 12px;
      padding: 1rem 1.1rem;
      text-decoration: none;
      display: block;
      transition: box-shadow 0.3s ease, border-color 0.3s ease;
      cursor: pointer;
    }

    .video-card:hover {
      border-color: #a855f7;
      box-shadow: 0 0 10px #a855f7, 0 0 25px #9333ea;
    }

    .video-icon {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      background: #1a0a2e;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 10px;
    }

    .play-triangle {
      width: 0;
      height: 0;
      border-top: 7px solid transparent;
      border-bottom: 7px solid transparent;
      border-left: 12px solid #a855f7;
      margin-left: 3px;
    }

    .video-label {
      font-size: 11px;
      color: #a855f7;
      font-weight: 500;
      margin: 0 0 4px;
      letter-spacing: 0.03em;
      font-family: 'Inter', sans-serif;
    }

    .video-title {
      font-size: 14px;
      font-weight: 500;
      color: #ffffff;
      margin: 0 0 4px;
      line-height: 1.4;
      font-family: 'Cinzel', serif;
    }

    .video-desc {
      font-size: 12px;
      color: #8d96b2;
      margin: 0;
      line-height: 1.5;
      font-family: 'Playfair Display', serif;
    }
  </style>
</head>

<body>
  <Navbar/>

  <div class="banner">
    <div class="overlay">
      <div>
        <h1>Iteron</h1>
        <br>
        <p>The Game of Trust and Strategy</p>
      </div>
    </div>
  </div>

  <div class="mainsecanim">
    <div class="main-section">
      <div class="slide-box">
        <p>
          In 1980, a political scientist asked:
          "In a world of egoists, does it ever pay to be nice?"
        </p>
      </div>
    </div>
  </div>

  <section class="legacy">
    <h1>The Legacy of Axelrod</h1>
    <p class="intro">
      Axelrod invited game theorists, mathematicians, and sociologists to submit computer programs (strategies) to play against each other thousands of times.
      Participants submitted computer programs for playing the Iterated Prisoner's Dilemma, where each program repeatedly decided whether to cooperate or defect against others.
      Every strategy played many rounds against all others, earning points based on outcomes. Goal of the tournament was to see which strategy performed best over time.
    </p>
    <div class="points">
      <div class="point">
        <span class="arrow">›</span>
        <div>
          <h3>Cooperation Evolved</h3>
          <p>Proved altruism can be mathematically stable.</p>
        </div>
      </div>
      <div class="point">
        <span class="arrow">›</span>
        <div>
          <h3>The 14 Original Strategies</h3>
          <p>Ranged from extremely simple to highly complex.</p>
        </div>
      </div>
      <div class="point">
        <span class="arrow">›</span>
        <div>
          <h3>Tit-For-Tat Supremacy</h3>
          <p>Winning via simple reciprocity and trust.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="strategy-section">
    <div class="strategy-left">
      <h2 class="strategy-title">
        Introducing<br><br>ITERON
      </h2>
      <br>
      <p class="strategy-text">
        Inspired by Axelrod, but forged in harsher terrain,<br><br>
        In Iteron, strategies face multiple environments, unstable incentives, and repeated trials.
        <br><br>
        Victory is not about winning once — it's about enduring everywhere.
      </p>
      <div class="strategy-buttons">
        <a href="/submissions">Explore the Tournament</a>
      </div>
    </div>
  </section>

  <section class="phase-section">
    <div class="phase-header">TOURNAMENT PHASE FLOW</div>
    <div class="phase-line"></div>
    <div class="phase-container">
      <div class="phase">
        <div class="phase-number">01</div>
        <h3>SUBMISSION</h3>
      </div>
      <div class="phase">
        <div class="phase-number">02</div>
        <h3>MODIFICATION</h3>
      </div>
      <div class="phase">
        <div class="phase-number">03</div>
        <h3>ROUND-ROBIN</h3>
      </div>
      <div class="phase">
        <div class="phase-number">04</div>
        <h3>SELECTION</h3>
      </div>
      <div class="phase">
        <div class="phase-number">05</div>
        <h3>RESULTS</h3>
      </div>
    </div>
  </section>



  <div class="help-section">
    <div class="help-header">
      <span class="help-badge">Help</span>
    </div>
    <p class="help-title">New to game theory?</p>
    <p class="help-subtitle">If you're just getting started with the concepts of game theory, these videos will walk you through the fundamentals.</p>
    <hr class="help-divider">
    <div class="video-grid">

      <a class="video-card" href="https://youtu.be/3Y1WpytiHKE?si=hAzkLdrZea102V4T" target="_blank">
        <div class="video-icon"><div class="play-triangle"></div></div>
        <p class="video-label"> 4min</p>
        <p class="video-title">Introduction to Game Theory</p>
        <p class="video-desc">What is game theory and why does it matter?</p>
      </a>

      <a class="video-card"https://youtu.be/t9Lo2fgxWHw?si=GikX2THhcJvzZjRU" target="_blank">
        <div class="video-icon"><div class="play-triangle"></div></div>
        <p class="video-label">6 min</p>
        <p class="video-title">The Prisoner's Dilemma</p>
        <p class="video-desc">One of the most famous game theory scenario explained simply.Learn how payoff matrices work and rational thinking is done.</p>
      </a>

      <a class="video-card" https://youtu.be/mScpHTIi-kM?si=vkVr1xUnCcgBNDpz">
        <div class="video-icon"><div class="play-triangle"></div></div>
        <p class="video-label">IMPORTANT - 28 min</p>
        <p class="video-title">Axelrod's Tournament</p>
        <p class="video-desc">This is the video that inspired the creation of ITERON.Learn all about Axelrod's tournament here.</p>
      </a>

     

    </div>
  </div>

  <div class="contact-section">
    <div class="contact-divider">
      <div class="contact-divider-line"></div>
      <span class="contact-divider-ornament">✦</span>
      <div class="contact-divider-line"></div>
    </div>
    <p class="contact-text">In case of any queries, reach us at</p>
    <a href="mailto:iteron.iiserm@gmail.com" class="contact-email">iteron.iiserm@gmail.com</a>
  </div>

  

  <footer>&mdash; Iteron 2026 &mdash;</footer>
</body>
</html>
