  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      background-image: url("/images/bg5.jpeg");
      font-family: 'Playfair Display', serif;
    }

    .banner {
      height: 60vh;
      background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url("/images/Hand.jpeg");
      background-size: cover;
      background-position: center;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .overlay {
      height: 100%;
      display: grid;
      place-items: center;
      text-align: center;
      color: white;
    }

    .mainsecanim {
      opacity: 0;
      transform: translateY(20px);
      animation: fadeSlideIn 0.8s ease-out forwards;
    }

    @keyframes fadeSlideIn {
      to { opacity: 1; transform: translateY(0); }
    }

    /* ── FIX: added missing fadeUp keyframe ── */
    @keyframes fadeUp {
      to { opacity: 1; transform: translateY(0); }
    }

    .main-section {
      min-height: 20vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 40px 20px;
      color: #f0f7f8;
      font-family: 'Cinzel';
    }

    .slide-box {
      max-width: 600px;
      background: black;
      padding: 30px;
      border-radius: 8px;
      box-shadow: 0 0 40px rgba(128, 0, 255, 0.6);
    }

    .main-section2 {
      min-height: 1vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 50px 20px;
      color: #f0f7f8;
      font-family: 'Cinzel';
    }

    .slide-box2 {
      max-width: 600px;
      background: black;
      padding: 40px;
      border-radius: 8px;
    }
    .slide-box2:hover {
      box-shadow: 0 0 10px #a855f7, 0 0 25px #9333ea, 0 0 40px #7e22ce;
    }

    .legacy {
      max-width: 800px;
      margin: 80px auto;
      padding: 20px;
      color: #ffffff;
    }

    .legacy h1 {
      font-size: 3rem;
      margin-bottom: 10px;
      font-weight: 700;
      text-align: center;
    }

    .intro {
      font-size: 1.1rem;
      line-height: 1.7;
      color: #a9b4c2;
      margin-bottom: 40px;
      text-align: center;
    }
    .intro strong { color: #ffffff; }

    .points {
      display: flex;
      flex-direction: column;
      gap: 25px;
    }

    .point {
      display: flex;
      align-items: flex-start;
      gap: 15px;
    }

