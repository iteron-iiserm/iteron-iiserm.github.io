---
import "@fontsource/share-tech-mono/latin-400.css";
import "@fontsource/space-grotesk/latin-400.css";
import "@fontsource/space-grotesk/latin-700.css";
import "../styles/tokens.css";

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	image?: string;
	noindex?: boolean;
}

const {
	title = "Iteron | Turing Club IISER Mohali",
	description = "Iteron is a game theory and strategy tournament by Turing Club, IISER Mohali. Find updates, submissions, and tournament results.",
	canonicalPath,
	image = "/turinglogo-wo-bg.png",
	noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";

const websiteData = {
	"@type": "WebSite",
	"@id": `${siteUrl.toString()}#website`,
	name: "Iteron",
	url: siteUrl.toString(),
	inLanguage: "en",
	description,
	publisher: {
		"@id": `${siteUrl.toString()}#organization`,
	},
};

const organizationData = {
	"@type": "Organization",
	"@id": `${siteUrl.toString()}#organization`,
	name: "Turing Club, IISER Mohali",
	url: siteUrl.toString(),
	logo: imageUrl.toString(),
	sameAs: [
		"https://github.com/IISERM/",
		"https://www.iisermohali.ac.in/",
	],
};

const webPageData = {
	"@type": "WebPage",
	"@id": `${canonicalUrl.toString()}#webpage`,
	url: canonicalUrl.toString(),
	name: title,
	description,
	inLanguage: "en",
	isPartOf: {
		"@id": `${siteUrl.toString()}#website`,
	},
};

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [organizationData, websiteData, webPageData],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/turing-logo_wbg-5c.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/turing-logo_wbg-5c.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="Iteron, game theory, Axelrod, Robert Axelrod, IISER, IISERM, IISER Mohali, Turing, Turing Club, computation club, computation, coding, competition, tournament, prisoner's dilemma, iterated prisoner's dilemma, dilemma, Nash, John Nash, Nash equilibrium, Nash equillibrium, dynamical systems, mathematics, math, computing, research, top university, India, strategy, strategy tournament, game theory competition" />
		<meta name="news_keywords" content="Iteron, game theory, Axelrod, Robert Axelrod, IISER Mohali, Turing Club, coding competition, prisoner's dilemma, Nash equilibrium" />
		<meta name="robots" content={robotsContent} />

		<link rel="canonical" href={canonicalUrl.toString()} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Iteron" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl.toString()} />
		<meta property="og:image" content={imageUrl.toString()} />

		<meta name="google-site-verification" content="sPbbPvNGEM9AQpLVH5Z2tzGCzPQaj9tbDYOho-Vf2j8" />
		<meta name="google-site-verification" content="9JhF715fk1xbANs4JRjia2PZdebam3tCYYVBUifeNnA" />
		
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl.toString()} />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<slot />
		<script>
			const HAPTIC_MS = 8;
			const touchSelector = 'a, button, [role="button"], [data-haptic]';
			const ABOUT_PREWARM_KEY = 'iteron-about-prewarmed-v1';

			function isHapticSupported() {
				return typeof navigator !== 'undefined' && typeof navigator.vibrate === 'function';
			}

			function isLikelyTouchDevice() {
				return window.matchMedia('(hover: none) and (pointer: coarse)').matches;
			}

			function triggerGentleHaptic() {
				if (!isHapticSupported()) return;
				navigator.vibrate(HAPTIC_MS);
			}

			function shouldPrewarmAboutPage() {
				const navWithConnection = navigator as Navigator & {
					connection?: { saveData?: boolean };
				};

				if (window.location.pathname === '/about') return false;
				if (sessionStorage.getItem(ABOUT_PREWARM_KEY) === '1') return false;
				if (navWithConnection.connection?.saveData) return false;
				return true;
			}

			async function prewarmAboutPageAssets() {
				if (!shouldPrewarmAboutPage()) return;

				try {
					const response = await fetch('/about', {
						credentials: 'same-origin',
						headers: { 'x-about-prewarm': '1' },
					});
					if (!response.ok) return;

					const html = await response.text();
					const parser = new DOMParser();
					const doc = parser.parseFromString(html, 'text/html');

					const imageUrls = new Set(
						Array.from(doc.querySelectorAll('img[src]'))
							.map((img) => img.getAttribute('src'))
							.filter((src): src is string => Boolean(src))
					);

					imageUrls.forEach((src) => {
						const preloadImage = new Image();
						preloadImage.decoding = 'async';
						preloadImage.src = src;
					});

					sessionStorage.setItem(ABOUT_PREWARM_KEY, '1');
				} catch {
					// Ignore prewarm failures and keep normal navigation behavior.
				}
			}

			if (isLikelyTouchDevice()) {
				document.addEventListener('pointerdown', (event) => {
					const pointerEvent = event as PointerEvent;
					if (pointerEvent.pointerType !== 'touch') return;

					const target = event.target as Element | null;
					if (!target) return;

					const interactive = target.closest(touchSelector);
					if (!interactive || interactive.hasAttribute('data-no-haptic')) return;

					triggerGentleHaptic();
				}, { passive: true });
			}

			const winWithIdle = window as Window & typeof globalThis & {
				requestIdleCallback?: (callback: IdleRequestCallback, options?: IdleRequestOptions) => number;
			};

			if (typeof winWithIdle.requestIdleCallback === 'function') {
				winWithIdle.requestIdleCallback(() => {
					void prewarmAboutPageAssets();
				}, { timeout: 2500 });
			} else {
				globalThis.setTimeout(() => {
					void prewarmAboutPageAssets();
				}, 1200);
			}
		</script>
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html, body {
		width: 100%;
		min-height: 100vh;
		background-color: var(--bg-color);
		color: var(--text-white);
		font-family: var(--font-mono);
	}

	/* The Vaporwave Draft Grid Background */
	body {
		background-image:
			linear-gradient(var(--grid-color) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
		background-size: 50px 50px;
		background-attachment: fixed;
		overflow-x: hidden;
	}

	main {
		width: 100%;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font-display);
		text-transform: uppercase;
		font-weight: 700;
		line-height: 1.2;
	}

	p,
	li {
		line-height: 1.7;
	}

	/* Glitch styling removed: keep headings as normal text */
	.glitch {
		position: static;
		display: inline;
	}

	/* Utility: Brutalist blocks */
	.brutalist-block {
		background: #000;
		border: 1px solid var(--border-color);
		padding: 2rem;
		box-shadow: 4px 4px 0 var(--accent-purple);
		transition: transform 0.2s, box-shadow 0.2s;
	}

	.brutalist-block:hover {
		transform: translate(2px, 2px);
		box-shadow: 2px 2px 0 var(--accent-purple);
	}

	a {
		color: var(--accent-purple);
		text-decoration: none;
	}

	a:hover {
		color: #000;
		background-color: var(--accent-purple);
	}

	@media (max-width: 1024px) {
		html {
			font-size: 15px;
		}

		.brutalist-block {
			padding: 1.5rem;
		}
	}

	@media (max-width: 768px) {
		html {
			font-size: 15px;
		}

		body {
			background-size: 36px 36px;
			background-attachment: scroll;
		}

		.brutalist-block {
			padding: 1.5rem;
		}
	}

	@media (max-width: 480px) {
		html {
			font-size: 15px;
		}

		.brutalist-block {
			padding: 1.35rem;
		}
	}
</style>
