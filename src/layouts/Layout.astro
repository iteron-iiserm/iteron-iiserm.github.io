---
import "@fontsource/share-tech-mono/latin-400.css";
import "@fontsource/space-grotesk/latin-400.css";
import "@fontsource/space-grotesk/latin-700.css";
import "../styles/tokens.css";

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	image?: string;
	noindex?: boolean;
}

const {
	title = "Iteron | Turing Club IISER Mohali",
	description = "Iteron is a game theory and strategy tournament by Turing Club, IISER Mohali. Find updates, submissions, and tournament results.",
	canonicalPath,
	image = "/turinglogo-wo-bg.png",
	noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";

const structuredData = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Iteron",
	url: siteUrl.toString(),
	description,
	publisher: {
		"@type": "Organization",
		name: "Turing Club, IISER Mohali",
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/turinglogo-wo-bg.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="Iteron, IISER Mohali, Turing Club, game theory, strategy tournament" />
		<meta name="robots" content={robotsContent} />

		<link rel="canonical" href={canonicalUrl.toString()} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Iteron" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl.toString()} />
		<meta property="og:image" content={imageUrl.toString()} />

		<meta name="google-site-verification" content="sPbbPvNGEM9AQpLVH5Z2tzGCzPQaj9tbDYOho-Vf2j8" />		
		
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl.toString()} />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html, body {
		width: 100%;
		min-height: 100vh;
		background-color: var(--bg-color);
		color: var(--text-white);
		font-family: var(--font-mono);
	}

	/* The Vaporwave Draft Grid Background */
	body {
		background-image:
			linear-gradient(var(--grid-color) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
		background-size: 50px 50px;
		background-attachment: fixed;
		overflow-x: hidden;
	}

	main {
		width: 100%;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font-display);
		text-transform: uppercase;
		font-weight: 700;
		line-height: 1.2;
	}

	p,
	li {
		line-height: 1.7;
	}

	/* Glitch styling removed: keep headings as normal text */
	.glitch {
		position: static;
		display: inline;
	}

	/* Utility: Brutalist blocks */
	.brutalist-block {
		background: #000;
		border: 1px solid var(--border-color);
		padding: 2rem;
		box-shadow: 4px 4px 0 var(--accent-purple);
		transition: transform 0.2s, box-shadow 0.2s;
	}

	.brutalist-block:hover {
		transform: translate(2px, 2px);
		box-shadow: 2px 2px 0 var(--accent-purple);
	}

	a {
		color: var(--accent-purple);
		text-decoration: none;
	}

	a:hover {
		color: var(--text-white);
		background-color: var(--accent-purple);
	}

	@media (max-width: 1024px) {
		html {
			font-size: 15px;
		}

		.brutalist-block {
			padding: 1.5rem;
		}
	}

	@media (max-width: 768px) {
		html {
			font-size: 15px;
		}

		body {
			background-size: 36px 36px;
			background-attachment: scroll;
		}

		.brutalist-block {
			padding: 1.5rem;
		}
	}

	@media (max-width: 480px) {
		html {
			font-size: 15px;
		}

		.brutalist-block {
			padding: 1.35rem;
		}
	}
</style>
