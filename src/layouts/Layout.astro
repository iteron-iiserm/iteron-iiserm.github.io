---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Google Fonts for Brutalist / Vaporwave aesthetic -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Space+Grotesk:wght@400;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg-color: #101014;
		--grid-color: rgba(255, 255, 255, 0.04);
		--accent-purple: #ba8fd8;
		--accent-dark: #8146a8;
		--text-white: #f5f5f5;
		--border-color: #ffffff;
		
		--font-display: 'Space Grotesk', sans-serif;
		--font-mono: 'Share Tech Mono', monospace;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html, body {
		width: 100%;
		min-height: 100vh;
		background-color: var(--bg-color);
		color: var(--text-white);
		font-family: var(--font-mono);
	}

	/* The Vaporwave Draft Grid Background */
	body {
		background-image:
			linear-gradient(var(--grid-color) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
		background-size: 50px 50px;
		background-attachment: fixed;
		overflow-x: hidden;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font-display);
		text-transform: uppercase;
		font-weight: 700;
	}

	/* Glitch headline treatment used across section/page headers */
	.glitch {
		position: relative;
		display: inline-block;
	}

	.glitch::before,
	.glitch::after {
		content: attr(data-text);
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.glitch::before {
		left: 2px;
		text-shadow: -2px 0 #00f0ff;
		clip-path: inset(0 0 55% 0);
		opacity: 0.45;
	}

	.glitch::after {
		left: -2px;
		text-shadow: 2px 0 #ff2a6d;
		clip-path: inset(45% 0 0 0);
		opacity: 0.45;
	}

	/* Utility: Brutalist blocks */
	.brutalist-block {
		background: #000;
		border: 1px solid var(--border-color);
		padding: 2rem;
		box-shadow: 4px 4px 0 var(--accent-purple);
		transition: transform 0.2s, box-shadow 0.2s;
	}

	.brutalist-block:hover {
		transform: translate(2px, 2px);
		box-shadow: 2px 2px 0 var(--accent-purple);
	}

	a {
		color: var(--accent-purple);
		text-decoration: none;
	}

	a:hover {
		color: var(--text-white);
		background-color: var(--accent-purple);
	}
</style>
