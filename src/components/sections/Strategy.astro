---
import { Image } from "astro:assets";
import worldMapImg from "../../assets/world-map-vertical.png";
import evoGameTheoryImg from "../../assets/evo-game-theory.png";
---

<section class="strategy-section">
  <div class="vertical-text">
    <Image
      src={evoGameTheoryImg}
      alt="Evolutionary Game Theory"
      class="evo-text-img"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="strategy-wrapper brutalist-block">
    <div class="map-sidecard">
      <Image
        src={worldMapImg}
        alt="World Map"
        class="world-map-img"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="strategy-content">
      <div class="heading-box">
        <h2 class="strategy-title">INTRODUCING <br /> ITERON</h2>
      </div>

      <div class="text-block">
        <p class="strategy-text">
          Inspired by Axelrod, but forged in diverse terrains.<br /><br />
          In Iteron, strategies face multiple environments, unstable incentives, and
          repeated trials.
          <br /><br />
          <span class="highlight"
            >Victory is not about winning once — it's about enduring everywhere.</span
          >
        </p>
      </div>

      <div class="strategy-buttons">
        <a href="/submissions" class="btn-primary">[ EXPLORE THE TOURNAMENT ]</a
        >
      </div>
    </div>
  </div>
</section>

<style>
  .strategy-section {
    position: relative;
    padding: 10rem 5%;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 80vh;
    overflow: hidden;
  }

  .strategy-wrapper {
    display: flex;
    flex-wrap: wrap;
    max-width: 1200px;
    width: 100%;
    position: relative;
    z-index: 2;
    padding: 0;
    overflow: hidden;
  }

  .map-sidecard {
    flex: 0.5;
    min-width: 250px;
    max-width: 350px;
    background: #111;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0;
    overflow: hidden;
    border-right: 4px solid var(--accent-purple);
  }

  .world-map-img {
    width: auto;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
  }

  .vertical-text {
    position: absolute;
    right: 5%;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    opacity: 0.8;
  }

  .evo-text-img {
    height: 60vh;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(4px 4px 0 rgba(186, 143, 216, 0.3));
  }

  .strategy-content {
    flex: 1.2;
    min-width: 400px;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding: 4rem;
  }

  .heading-box {
    border-bottom: 2px solid var(--accent-purple);
    padding-bottom: 1rem;
    display: inline-block;
  }

  .strategy-title {
    font-size: 4rem;
    line-height: 1;
    color: var(--text-white);
    margin: 0;
  }

  .text-block p {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--text-white);
  }

  .highlight {
    color: var(--accent-purple);
    font-weight: bold;
    display: block;
    margin-top: 1rem;
    padding-left: 1rem;
    border-left: 4px solid var(--accent-purple);
  }

  .strategy-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 2rem;
  }

  .btn-primary {
    display: inline-block;
    background: var(--text-white);
    color: #000;
    padding: 1rem 2rem;
    font-family: var(--font-mono);
    font-weight: bold;
    font-size: 1.2rem;
    border: 2px solid var(--text-white);
    text-transform: uppercase;
    transition: all 0.2s;
    box-shadow: 4px 4px 0 var(--accent-purple);
  }

  .btn-primary:hover {
    background: #000;
    color: var(--text-white);
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--accent-purple);
  }

  @media (max-width: 1024px) {
    .strategy-section {
      padding: 5rem 1rem;
    }

    .strategy-wrapper {
      flex-direction: column;
    }

    .map-sidecard {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      min-height: 220px;
      border-right: none;
      border-bottom: 4px solid var(--accent-purple);
    }

    .world-map-img {
      width: 100%;
      height: 220px;
    }

    .strategy-content {
      min-width: 0;
      width: 100%;
      padding: 2rem 1.25rem;
      gap: 1.5rem;
    }

    .evo-text-img {
      height: 40vh;
    }

    .strategy-title {
      font-size: 3rem;
    }
  }

  @media (max-width: 768px) {
    .strategy-section {
      padding: 5.5rem 1.25rem;
    }

    .vertical-text {
      display: none;
    }

    .strategy-title {
      font-size: 2.2rem;
    }

    .btn-primary {
      width: 100%;
      text-align: center;
      font-size: 1rem;
      padding: 0.9rem 1rem;
    }
  }

  @media (max-width: 480px) {
    .strategy-content {
      padding: 1.9rem 1.1rem;
    }

    .strategy-title {
      font-size: 1.8rem;
    }

    .text-block p {
      font-size: 1.05rem;
      line-height: 1.8;
    }
  }
</style>
