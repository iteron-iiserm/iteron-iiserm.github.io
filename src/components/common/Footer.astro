---
import { Image } from "astro:assets";
import turingLogo from "../../assets/turinglogo-wo-bg.png";
import iiserLogo from "../../assets/iiser-mohali-logo.png";
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-col footer-branding">
      <div class="brand-logos">
        <a
          href="https://github.com/IISERM/"
          target="_blank"
          rel="noopener noreferrer"
          class="logo-link"
        >
          <Image
            src={turingLogo}
            alt="Turing Club Logo"
            class="footer-logo turing-logo"
          />
        </a>
        <span class="logo-divider"></span>
        <a
          href="https://www.iisermohali.ac.in/"
          target="_blank"
          rel="noopener noreferrer"
          class="logo-link"
        >
          <Image
            src={iiserLogo}
            alt="IISER Mohali Logo"
            class="footer-logo iiser-logo"
          />
        </a>
      </div>
      <p class="brand-text">
        <strong>TURING CLUB</strong><br />
        <span class="brand-sub">IISER Mohali</span>
      </p>
    </div>

    <div class="footer-col footer-nav">
      <div class="col-label">> SITEMAP</div>
      <ul>
        <li><a href="/">HOME</a></li>
        <li><a href="/updates">UPDATES</a></li>
        <li><a href="/submissions">SUBMISSION</a></li>
        <li><a href="/results">RESULTS</a></li>
        <li><a href="/about">ABOUT</a></li>
      </ul>
    </div>

    <div class="footer-col footer-policies">
      <div class="col-label">> LINKS</div>
      <ul>
        <li>
          <a
            href="https://github.com/IISERM/"
            target="_blank"
            rel="noopener noreferrer">GITHUB ↗</a
          >
        </li>
        <li>
          <a
            href="https://www.iisermohali.ac.in/"
            target="_blank"
            rel="noopener noreferrer">IISER MOHALI ↗</a
          >
        </li>
      </ul>

      <div class="col-label">> POLICIES</div>
      <ul>
        <li><a href="/terms-of-use">TERMS OF USE</a></li>
        <li><a href="/privacy-policy">PRIVACY POLICY</a></li>
        <li><a href="/takedown-policy">TAKEDOWN POLICY</a></li>
      </ul>
    </div>

    <div class="footer-col footer-community">
      <div class="col-label">> COMMUNITY</div>
      <ul>
        <li>
          <a
            href="https://github.com/IISERM/iteron-iiserm.github.io/issues/new/choose"
            target="_blank"
            rel="noopener noreferrer">RAISE AN ISSUE ↗</a
          >
        </li>
        <li>
          <a
            href="https://github.com/IISERM/iteron-iiserm.github.io/pulls"
            target="_blank"
            rel="noopener noreferrer">OPEN A PULL REQUEST ↗</a
          >
        </li>
        <li>
          <a href="mailto:iteron.iiserm@gmail.com?subject=Iteron%20Website%20Feedback"
            >SEND FEEDBACK</a
          >
        </li>
      </ul>

      <div class="contact-group">
        <div class="col-label">> CONTACT</div>
        <ul>
          <li>
            <a href="mailto:iteron.iiserm@gmail.com">iteron.iiserm@gmail.com</a>
          </li>
          <li>
            <a href="mailto:turingclub@iisermohali.ac.in"
              >turingclub@iisermohali.ac.in</a
            >
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-line"></div>
    <p class="copyright">
      © {new Date().getFullYear()} TURING CLUB, IISER MOHALI. ALL RIGHTS RESERVED.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: #000;
    border-top: 2px solid var(--border-color);
    padding: 2.8rem 5% 1.4rem;
    margin-top: 4rem;
    font-family: var(--font-mono);
  }

  .footer-inner {
    max-width: 1160px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(220px, 1.4fr) repeat(3, minmax(160px, 1fr));
    gap: 2.1rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .col-label {
    color: var(--accent-purple);
    font-weight: bold;
    font-size: 0.78rem;
    letter-spacing: 3px;
    margin-bottom: 1rem;
  }

  .footer-policies .col-label + ul {
    margin-bottom: 1.15rem;
  }

  /* Branding column */
  .brand-logos {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .logo-link {
    display: flex;
    align-items: center;
    background: none !important;
  }

  .logo-link:hover {
    background: none !important;
  }

  .footer-logo {
    height: 42px;
    width: auto;
    object-fit: contain;
    transition:
      filter 0.3s,
      transform 0.3s;
  }

  .footer-logo:hover {
    transform: scale(1.05);
  }

  .iiser-logo {
    height: 48px;
  }

  .logo-divider {
    width: 1px;
    height: 34px;
    background: rgba(255, 255, 255, 0.15);
  }

  .brand-text {
    color: var(--text-white);
    font-size: 0.88rem;
    line-height: 1.45;
    letter-spacing: 2px;
  }

  .brand-sub {
    color: #888;
    font-size: 0.74rem;
    letter-spacing: 1px;
  }

  /* Nav columns */
  .footer-nav ul,
  .footer-policies ul,
  .footer-community ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-nav a,
  .footer-policies a,
  .footer-community a {
    color: #999;
    font-size: 0.78rem;
    text-decoration: none;
    letter-spacing: 1px;
    line-height: 1.45;
    padding: 2px 3px;
    transition:
      color 0.2s,
      background 0.2s;
    display: inline-block;
    background: none;
  }

  .footer-nav a:hover,
  .footer-policies a:hover,
  .footer-community a:hover {
    color: var(--bg-color);
    background: var(--accent-purple);
  }

  .contact-group {
    margin-top: 1.35rem;
  }

  /* Bottom bar */
  .footer-bottom {
    max-width: 1160px;
    margin: 2rem auto 0;
  }

  .footer-line {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    margin-bottom: 1rem;
  }

  .copyright {
    color: #555;
    font-size: 0.72rem;
    letter-spacing: 1.4px;
    text-align: center;
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .site-footer {
      width: 100%;
      margin: 3.6rem 0 0;
      padding: 2.4rem 1.25rem 1.25rem;
    }

    .footer-inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.4rem 1.5rem;
    }

    .footer-branding {
      grid-column: 1 / -1;
      align-items: center;
    }

    .brand-text {
      text-align: center;
    }

    .contact-group {
      margin-top: 0.9rem;
    }

    .footer-bottom {
      margin-top: 1.6rem;
    }
  }

  @media (max-width: 768px) {
    .site-footer {
      width: 100%;
      padding: 2.5rem 1.25rem 1.3rem;
      margin-top: 3.2rem;
    }

    .footer-inner {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }

    .brand-logos {
      justify-content: center;
    }

    .brand-text {
      text-align: center;
    }

    .col-label {
      text-align: center;
    }

    .footer-nav ul,
    .footer-policies ul,
    .footer-community ul {
      align-items: center;
    }

    .contact-group {
      margin-top: 1rem;
    }

    .footer-bottom {
      margin-top: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .site-footer {
      width: 100%;
      padding: 2.25rem 1rem 1.15rem;
    }

    .footer-inner {
      gap: 1.5rem;
    }

    .brand-logos {
      gap: 0.85rem;
    }

    .footer-logo {
      height: 38px;
    }

    .iiser-logo {
      height: 42px;
    }

    .logo-divider {
      height: 30px;
    }

    .footer-nav a,
    .footer-policies a,
    .footer-community a {
      font-size: 0.76rem;
    }

    .copyright {
      letter-spacing: 1px;
      line-height: 1.6;
    }
  }
</style>
