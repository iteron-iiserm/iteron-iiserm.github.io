    border: 1px solid transparent;
    transition: all 0.2s;
  }

  .vapor-nav ul a:hover,
  .vapor-nav ul a.active {
    background-color: var(--text-white);
    color: var(--bg-color);
    border: 1px solid var(--border-color);
    box-shadow: 2px 2px 0 var(--accent-purple);
    transform: translate(-2px, -2px);
